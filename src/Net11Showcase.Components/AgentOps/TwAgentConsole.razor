@implements IDisposable
@inject IAgentTransport Transport

<div class="space-y-4 @Class" data-testid="agent-console">
    <TwTakeoverBar Session="_session" />
    <TwApprovalGate Session="_session" />

    <div class="grid grid-cols-1 xl:grid-cols-[16rem_minmax(0,1fr)_22rem] gap-4">
        <div class="space-y-4">
            <TwAgentRoster Agents="_agents" SelectedId="_selected.Id" StatusText="@_session.Status.ToString()" OnSelect="a => _selected = a" />
        </div>

        <section aria-label="Conversation" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 flex flex-col gap-3 min-h-[28rem]">
            <div class="flex-1 space-y-3 overflow-y-auto" role="log" aria-live="polite" aria-label="Agent conversation" data-testid="timeline">
                @if (_session.Timeline.Count == 0)
                {
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        Ask <strong>@_selected.Name</strong> to do something. Risky tool calls will stop and wait for you.
                    </p>
                }
                @foreach (var item in _session.Timeline)
                {
                    @switch (item)
                    {
                        case AgentMessage m:
                            <div class="flex @(m.Role == "user" ? "justify-end" : "justify-start")">
                                <p class="max-w-[85%] rounded-2xl px-4 py-2.5 text-sm @(m.Role == "user" ? "bg-brand-700 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-100")" data-testid="message" data-role="@m.Role">
                                    @m.Content@if (m.IsStreaming)
                                    {<span class="inline-block w-1.5 h-4 ms-0.5 align-middle bg-current animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>}
                                </p>
                            </div>
                            break;
                        case ToolCallRecord c:
                            <TwToolCallCard Call="c" />
                            break;
                    }
                }
            </div>

            <form class="flex gap-2" @onsubmit="RunAsync" @onsubmit:preventDefault="true">
                <label for="agent-prompt" class="sr-only">Message to the agent</label>
                <input id="agent-prompt" type="text" @bind="_prompt" @bind:event="oninput" disabled="@_session.IsActive" data-testid="prompt"
                       class="flex-1 min-h-[44px] rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-3 text-sm text-slate-900 dark:text-slate-100 disabled:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
                <button type="submit" disabled="@(_session.IsActive || string.IsNullOrWhiteSpace(_prompt))" data-testid="run"
                        class="min-h-[44px] px-5 rounded-xl bg-brand-700 text-white text-sm font-bold hover:bg-brand-600 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500">
                    Run
                </button>
            </form>
        </section>

        <div class="space-y-4">
            <TwAgentStateInspector Session="_session" />
            <TwAuditTrail Session="_session" />
        </div>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<AgentProfile> DefaultAgents = new[]
    {
        new AgentProfile("refunds", "Refund Desk", "Support operations", "Looks up orders and issues refunds. Money movement always needs your approval.", "💳"),
    };

    private AgentRunSession _session = default!;
    private AgentProfile _selected = DefaultAgents[0];
    private IReadOnlyList<AgentProfile> _agents = DefaultAgents;
    private string _prompt = "Please refund order 4821, the desk arrived with a cracked leg.";

    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyList<AgentProfile>? Agents { get; set; }

    /// <summary>The live session, exposed so a host page can read status or drive it.</summary>
    public AgentRunSession Session => _session;

    protected override void OnInitialized()
    {
        _session = new AgentRunSession(Transport);
        _session.Changed += OnChanged;
    }

    protected override void OnParametersSet()
    {
        if (Agents is { Count: > 0 } supplied && !ReferenceEquals(supplied, _agents))
        {
            _agents = supplied;
            _selected = supplied[0];
        }
    }

    private bool _renderQueued;
    private int _renderedVersion = -1;

    private void OnChanged()
    {
        if (_renderQueued) return;
        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            if (_renderedVersion != _session.Version) StateHasChanged();
        });
    }

    protected override void OnAfterRender(bool firstRender) => _renderedVersion = _session.Version;

    private async Task RunAsync()
    {
        if (_session.IsActive || string.IsNullOrWhiteSpace(_prompt)) return;
        await _session.RunAsync(_prompt);
    }

    public void Dispose()
    {
        _session.Changed -= OnChanged;
        _session.Cancel();
    }
}
