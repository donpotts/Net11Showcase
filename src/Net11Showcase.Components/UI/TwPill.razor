@namespace Net11Showcase.Components.UI

<div class="inline-flex items-center gap-1.5 transition-all duration-150 select-none @GetSizeClasses() @GetVariantClasses() @(Clickable ? "cursor-pointer hover:shadow-xs" : "") @(Selected ? "ring-2 ring-brand-500/50 shadow-xs" : "") @CustomClass"
     @onclick="HandleClick"
     role="@(Clickable ? "button" : null)"
     tabindex="@(Clickable ? "0" : null)">
    
    <!-- Status Dot -->
    @if (ShowDot)
    {
        <span class="relative flex h-2 w-2">
            @if (PulseDot)
            {
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full @GetDotColor() opacity-75"></span>
            }
            <span class="relative inline-flex rounded-full h-2 w-2 @GetDotColor()"></span>
        </span>
    }

    <!-- Avatar / Icon Slot -->
    @if (!string.IsNullOrEmpty(AvatarUrl))
    {
        <img src="@AvatarUrl" alt="" class="w-4 h-4 rounded-full object-cover -ml-0.5" />
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <span class="text-xs opacity-80">@Icon</span>
    }

    <!-- Label / Content -->
    <span class="font-medium whitespace-nowrap">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    </span>

    <!-- Counter Badge -->
    @if (Count.HasValue)
    {
        <span class="inline-flex items-center justify-center px-1.5 py-0.2 rounded-full text-[10px] font-bold font-mono @GetCountBadgeClasses()">
            @(Count.Value > 99 ? "99+" : Count.Value.ToString())
        </span>
    }

    <!-- Dismissible Close Button -->
    @if (Removable)
    {
        <button type="button" 
                @onclick="HandleDismiss" 
                @onclick:stopPropagation="true"
                class="rounded-full p-0.5 hover:bg-black/10 dark:hover:bg-white/10 transition-colors ml-0.5 -mr-0.5 text-current opacity-70 hover:opacity-100"
                title="Remove">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    }
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "Soft"; // Soft, Solid, Outline, Glass, Glow
    [Parameter] public string Color { get; set; } = "Brand"; // Brand, Emerald, Sky, Amber, Rose, Purple, Slate
    [Parameter] public string Size { get; set; } = "md"; // xs, sm, md, lg
    [Parameter] public bool ShowDot { get; set; } = false;
    [Parameter] public bool PulseDot { get; set; } = false;
    [Parameter] public string? AvatarUrl { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public bool Removable { get; set; } = false;
    [Parameter] public bool Clickable { get; set; } = false;
    [Parameter] public bool Selected { get; set; } = false;
    [Parameter] public string CustomClass { get; set; } = "";

    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private async Task HandleClick()
    {
        if (Clickable && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    private async Task HandleDismiss()
    {
        if (OnDismiss.HasDelegate)
        {
            await OnDismiss.InvokeAsync();
        }
    }

    private string GetSizeClasses() => Size.ToLowerInvariant() switch
    {
        "xs" => "text-[10px] px-2 py-0.5 rounded-full",
        "sm" => "text-xs px-2.5 py-0.5 rounded-full",
        "lg" => "text-sm px-4 py-1.5 rounded-full font-semibold",
        _ => "text-xs px-3 py-1 rounded-full"
    };

    private string GetDotColor() => Color.ToLowerInvariant() switch
    {
        "emerald" => "bg-emerald-500",
        "sky" => "bg-sky-500",
        "amber" => "bg-amber-500",
        "rose" => "bg-rose-500",
        "purple" => "bg-purple-500",
        "slate" => "bg-slate-400 dark:bg-slate-500",
        _ => "bg-brand-500"
    };

    private string GetCountBadgeClasses() => Variant.ToLowerInvariant() switch
    {
        "solid" => "bg-white/20 text-white",
        _ => "bg-black/10 dark:bg-white/10 text-current"
    };

    private string GetVariantClasses()
    {
        var c = Color.ToLowerInvariant();
        var v = Variant.ToLowerInvariant();

        if (v == "solid")
        {
            return c switch
            {
                "emerald" => "bg-emerald-600 text-white shadow-xs hover:bg-emerald-700",
                "sky" => "bg-sky-600 text-white shadow-xs hover:bg-sky-700",
                "amber" => "bg-amber-600 text-white shadow-xs hover:bg-amber-700",
                "rose" => "bg-rose-600 text-white shadow-xs hover:bg-rose-700",
                "purple" => "bg-purple-600 text-white shadow-xs hover:bg-purple-700",
                "slate" => "bg-slate-700 dark:bg-slate-600 text-white shadow-xs hover:bg-slate-800",
                _ => "bg-brand-600 text-white shadow-xs hover:bg-brand-700"
            };
        }

        if (v == "outline")
        {
            return c switch
            {
                "emerald" => "border border-emerald-500 text-emerald-600 dark:text-emerald-400 bg-transparent hover:bg-emerald-50 dark:hover:bg-emerald-950/30",
                "sky" => "border border-sky-500 text-sky-600 dark:text-sky-400 bg-transparent hover:bg-sky-50 dark:hover:bg-sky-950/30",
                "amber" => "border border-amber-500 text-amber-600 dark:text-amber-400 bg-transparent hover:bg-amber-50 dark:hover:bg-amber-950/30",
                "rose" => "border border-rose-500 text-rose-600 dark:text-rose-400 bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/30",
                "purple" => "border border-purple-500 text-purple-600 dark:text-purple-400 bg-transparent hover:bg-purple-50 dark:hover:bg-purple-950/30",
                "slate" => "border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 bg-transparent hover:bg-slate-100 dark:hover:bg-slate-800",
                _ => "border border-brand-500 text-brand-600 dark:text-brand-400 bg-transparent hover:bg-brand-50 dark:hover:bg-brand-950/30"
            };
        }

        if (v == "glow")
        {
            return c switch
            {
                "emerald" => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 shadow-[0_0_12px_rgba(16,185,129,0.25)]",
                "sky" => "bg-sky-500/10 text-sky-400 border border-sky-500/30 shadow-[0_0_12px_rgba(14,165,233,0.25)]",
                "amber" => "bg-amber-500/10 text-amber-400 border border-amber-500/30 shadow-[0_0_12px_rgba(245,158,11,0.25)]",
                "rose" => "bg-rose-500/10 text-rose-400 border border-rose-500/30 shadow-[0_0_12px_rgba(244,63,94,0.25)]",
                "purple" => "bg-purple-500/10 text-purple-400 border border-purple-500/30 shadow-[0_0_12px_rgba(168,85,247,0.25)]",
                "slate" => "bg-slate-500/10 text-slate-300 border border-slate-500/30 shadow-[0_0_12px_rgba(148,163,184,0.15)]",
                _ => "bg-brand-500/10 text-brand-400 border border-brand-500/30 shadow-[0_0_12px_rgba(var(--color-brand-500),0.25)]"
            };
        }

        // Default: Soft
        return c switch
        {
            "emerald" => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40",
            "sky" => "bg-sky-100 text-sky-800 dark:bg-sky-950/40 dark:text-sky-300 border border-sky-200 dark:border-sky-800/40",
            "amber" => "bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/40",
            "rose" => "bg-rose-100 text-rose-800 dark:bg-rose-950/40 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40",
            "purple" => "bg-purple-100 text-purple-800 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40",
            "slate" => "bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700",
            _ => "bg-brand-100 text-brand-800 dark:bg-brand-950/40 dark:text-brand-300 border border-brand-200 dark:border-brand-800/40"
        };
    }
}
