@if (!_dismissed)
{
    <div role="alert" class="rounded-2xl border p-4 flex items-start gap-3 @AlertClasses @Class">
        <div class="shrink-0 mt-0.5">
            @switch (Variant)
            {
                case SemanticVariant.Success:
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    break;
                case SemanticVariant.Warning:
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    break;
                case SemanticVariant.Danger:
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    break;
                default:
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    break;
            }
        </div>

        <div class="flex-1 text-sm">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h4 class="font-semibold mb-0.5">@Title</h4>
            }
            <div class="opacity-90">@ChildContent</div>
        </div>

        @if (Dismissible)
        {
            <button type="button"
                    @onclick="Dismiss"
                    aria-label="Dismiss alert"
                    class="shrink-0 rounded-lg p-1 opacity-70 hover:opacity-100 transition-opacity">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>
}

@code {
    private bool _dismissed;

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SemanticVariant Variant { get; set; } = SemanticVariant.Info;
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task Dismiss()
    {
        _dismissed = true;
        await OnDismiss.InvokeAsync();
    }

    private string AlertClasses => Variant switch
    {
        SemanticVariant.Success => "bg-emerald-50/90 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/70 text-emerald-900 dark:text-emerald-200",
        SemanticVariant.Warning => "bg-amber-50/90 dark:bg-amber-950/40 border-amber-200 dark:border-amber-800/70 text-amber-900 dark:text-amber-200",
        SemanticVariant.Danger => "bg-rose-50/90 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/70 text-rose-900 dark:text-rose-200",
        SemanticVariant.Primary => "bg-brand-50/90 dark:bg-brand-500/10 border-brand-100 dark:border-brand-500/30 text-brand-700 dark:text-brand-100",
        _ => "bg-sky-50/90 dark:bg-sky-950/40 border-sky-200 dark:border-sky-800/70 text-sky-900 dark:text-sky-200"
    };
}
