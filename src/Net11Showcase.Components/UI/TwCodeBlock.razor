@inject IJSRuntime JS

<div class="relative rounded-2xl bg-slate-900 border border-slate-800 text-slate-100 overflow-hidden shadow-xl @Class">
    <!-- Header Bar -->
    <div class="flex items-center justify-between px-4 py-3 bg-slate-950/60 border-b border-slate-800/80">
        <div class="flex items-center gap-2">
            <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            @if (!string.IsNullOrWhiteSpace(FileName))
            {
                <span class="ml-2 text-xs font-mono text-slate-400">@FileName</span>
            }
        </div>

        <div class="flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(Language))
            {
                <span class="px-2 py-0.5 rounded-md bg-slate-800 text-[11px] font-mono text-slate-400 uppercase tracking-wider">
                    @Language
                </span>
            }
            <button type="button"
                    @onclick="CopyCode"
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition-colors">
                @if (_copied)
                {
                    <svg class="w-3.5 h-3.5 text-emerald-400 animate-zoom-in" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-emerald-400 font-semibold">Copied!</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span>Copy</span>
                }
            </button>
        </div>
    </div>

    <!-- Code Content -->
    <div class="p-4 overflow-x-auto text-xs sm:text-sm font-mono leading-relaxed select-all">
        <pre class="text-slate-200"><code>@Code</code></pre>
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public string? Language { get; set; } = "razor";
    [Parameter] public string? FileName { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _copied = false;

    private async Task CopyCode()
    {
        try
        {
            var success = await JS.InvokeAsync<bool>("blazorTailwind.copyToClipboard", Code);
            if (success)
            {
                _copied = true;
                StateHasChanged();
                await Task.Delay(2000);
                _copied = false;
            }
        }
        catch { }
    }
}
