@namespace Net11Showcase.Components.UI
@inject IJSRuntime JS

<div class="rounded-2xl bg-slate-950 border border-slate-800 text-slate-100 overflow-hidden shadow-xl @Class">
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-slate-900 border-b border-slate-800">
        <div class="flex items-center gap-2.5">
            <span class="text-xs font-mono font-bold text-slate-300">@FileName</span>
            <div class="flex items-center gap-1.5 text-[10px] font-mono font-bold">
                <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                    +@AddedCount
                </span>
                <span class="px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/30">
                    -@DeletedCount
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (AllowCopy)
            {
                <button type="button"
                        @onclick="CopyModifiedCode"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition-colors focus:outline-none">
                    @if (_copied)
                    {
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-emerald-400 font-semibold text-[11px]">Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span class="text-[11px]">Copy Code</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Diff Lines Table -->
    <div class="p-2 sm:p-4 overflow-x-auto text-xs font-mono select-all">
        <table class="w-full border-collapse">
            <tbody>
                @foreach (var line in Lines)
                {
                    var isAdded = line.Type == DiffType.Added;
                    var isDeleted = line.Type == DiffType.Deleted;

                    var rowBg = isAdded
                        ? "bg-emerald-950/40 text-emerald-300 border-l-2 border-emerald-500"
                        : isDeleted
                            ? "bg-rose-950/40 text-rose-300 border-l-2 border-rose-500"
                            : "text-slate-300 hover:bg-slate-900/40";

                    var sign = isAdded ? "+" : isDeleted ? "-" : " ";

                    <tr class="@rowBg transition-colors">
                        <td class="w-8 pr-2 text-right text-slate-600 select-none text-[10px]">
                            @(line.OldLineNumber?.ToString() ?? "")
                        </td>
                        <td class="w-8 pr-3 text-right text-slate-600 select-none text-[10px]">
                            @(line.NewLineNumber?.ToString() ?? "")
                        </td>
                        <td class="w-4 select-none text-center font-bold font-mono @(isAdded ? "text-emerald-400" : isDeleted ? "text-rose-400" : "text-slate-600")">
                            @sign
                        </td>
                        <td class="pl-2 whitespace-pre leading-relaxed">@line.Text</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    public enum DiffType { Unchanged, Added, Deleted }

    public sealed record DiffLine(
        DiffType Type,
        string Text,
        int? OldLineNumber = null,
        int? NewLineNumber = null
    );

    [Parameter] public string FileName { get; set; } = "diff.razor";
    [Parameter] public IReadOnlyList<DiffLine> Lines { get; set; } = Array.Empty<DiffLine>();
    [Parameter] public string? OldCode { get; set; }
    [Parameter] public string? NewCode { get; set; }
    [Parameter] public bool AllowCopy { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        if (Lines.Count == 0 && (OldCode != null || NewCode != null))
        {
            var list = new List<DiffLine>();
            var oldLines = (OldCode ?? "").Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
            var newLines = (NewCode ?? "").Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);

            for (int i = 0; i < oldLines.Length; i++)
            {
                list.Add(new DiffLine(DiffType.Deleted, oldLines[i], OldLineNumber: i + 1));
            }
            for (int i = 0; i < newLines.Length; i++)
            {
                list.Add(new DiffLine(DiffType.Added, newLines[i], NewLineNumber: i + 1));
            }
            Lines = list;
        }
    }

    private bool _copied = false;

    private int AddedCount => Lines.Count(l => l.Type == DiffType.Added);
    private int DeletedCount => Lines.Count(l => l.Type == DiffType.Deleted);

    private async Task CopyModifiedCode()
    {
        var modified = string.Join("\n", Lines.Where(l => l.Type != DiffType.Deleted).Select(l => l.Text));
        if (string.IsNullOrEmpty(modified)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", modified);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
        }
        catch { }
    }
}
