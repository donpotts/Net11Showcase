<div class="w-full @Class">
    <!-- Tab navigation headers: horizontally scrollable on mobile -->
    <div class="border-b border-slate-200 dark:border-slate-800">
        <nav class="-mb-px flex space-x-2 sm:space-x-4 overflow-x-auto no-scrollbar py-1" aria-label="Tabs">
            @foreach (var tab in Tabs)
            {
                var isActive = tab.Key == ActiveTabKey;
                <button type="button"
                        @onclick="() => SelectTab(tab.Key)"
                        class="whitespace-nowrap px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl transition-all duration-150 inline-flex items-center gap-2 @(Variant == "pills" ? (isActive ? "bg-brand-600 text-white shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800") : (isActive ? "border-b-2 border-brand-600 text-brand-600 dark:text-brand-500 font-semibold" : "border-b-2 border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700"))">
                    @if (!string.IsNullOrWhiteSpace(tab.SvgIcon))
                    {
                        <span class="w-4 h-4 shrink-0">@((MarkupString)tab.SvgIcon)</span>
                    }
                    <span>@tab.Title</span>
                    @if (!string.IsNullOrWhiteSpace(tab.Badge))
                    {
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold @(isActive ? "bg-brand-500/20 text-brand-100" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300")">
                            @tab.Badge
                        </span>
                    }
                </button>
            }
        </nav>
    </div>

    <!-- Active Tab Panel -->
    <div class="py-4">
        @ChildContent
    </div>
</div>

@code {
    public sealed record TabDefinition(string Key, string Title, string? SvgIcon = null, string? Badge = null);

    [Parameter] public IReadOnlyList<TabDefinition> Tabs { get; set; } = Array.Empty<TabDefinition>();
    [Parameter] public string? ActiveTabKey { get; set; }
    [Parameter] public EventCallback<string> ActiveTabKeyChanged { get; set; }
    [Parameter] public string Variant { get; set; } = "underline"; // underline or pills
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task SelectTab(string key)
    {
        ActiveTabKey = key;
        await ActiveTabKeyChanged.InvokeAsync(key);
    }
}
