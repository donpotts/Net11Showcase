@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
    <!-- Modern Header / AppShell Navigation Bar -->
    <header class="sticky top-0 z-40 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 px-4 sm:px-8 py-3.5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center text-xl shadow-lg shadow-indigo-500/20 shrink-0">
                ⚡
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-base sm:text-lg font-black tracking-tight text-white">.NET 11 Showcase Suite</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                        v11.0.0-rc.3
                    </span>
                </div>
                <p class="text-[11px] text-slate-400 hidden sm:block">
                    Blazor Auto • MAUI Hybrid • EF Core 11 • Minimal APIs • Native AOT • AI RAG
                </p>
            </div>
        </div>

        <!-- Header Actions & Status Badges -->
        <div class="flex items-center gap-2 sm:gap-3 text-xs">
            <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-emerald-400 font-mono text-[11px]">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>CoreCLR PGO Active</span>
            </div>

            <a href="http://127.0.0.1:5128/scalar/v1" target="_blank"
               class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center gap-1.5 font-semibold">
                <span>📖 Scalar OpenAPI</span>
            </a>

            <a href="https://github.com/donpotts/BlazorTailwindUI" target="_blank"
               class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition flex items-center gap-1.5 shadow-sm">
                <span>⭐ GitHub</span>
            </a>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        @Body
    </main>

    <!-- Enterprise Footer -->
    <footer class="w-full border-t border-slate-800 bg-slate-900/50 py-6 px-4 sm:px-8 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
            <div>
                <strong>.NET 11 Showcase Platform & Enterprise Reference Architecture</strong> — 100% Free Open-Source Architecture.
            </div>
            <div class="flex items-center gap-3 text-slate-400">
                <span>Free Local SQLite</span>
                <span>•</span>
                <span>In-Memory Vectors</span>
                <span>•</span>
                <span>Azure Cloud Ready</span>
            </div>
        </div>
    </footer>
</div>
