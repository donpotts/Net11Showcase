                            <div class="flex items-center gap-3">
                                <span class="text-slate-400 text-xs">@endpoint.Summary</span>
                                <button type="button" @onclick="() => ExecuteApiProbe(endpoint.Route)"
                                        class="px-3 py-1 rounded-xl bg-indigo-600/80 hover:bg-indigo-600 text-white font-mono text-[11px] font-bold">
                                    Execute Probe
                                </button>
