                    <div class="p-4 rounded-2xl bg-slate-950 border border-indigo-500/30 font-mono text-xs space-y-2">
                        <div class="flex items-center justify-between text-indigo-300 border-b border-slate-800 pb-2">
                            <span>Probe Target: <strong>@_lastProbedRoute</strong> (HTTP 200 OK • @_lastProbeLatencyMs ms)</span>
                            <button type="button" @onclick='() => _apiConsoleOutput = ""' class="text-slate-400 hover:text-white">✕ Clear</button>
                        </div>
                        <pre class="text-emerald-400 overflow-x-auto text-[11px] leading-relaxed">@_apiConsoleOutput</pre>
                    </div>
