                        <button type="button" @onclick="() => FilterJsonCategory(cat)"
                                class="px-3 py-1 rounded-xl border text-xs font-mono transition @(_selectedJsonCategory == cat ? "border-indigo-500 bg-indigo-950/40 text-white" : "border-slate-800 bg-slate-950 text-slate-400 hover:text-white")">
