@page "/"
@rendermode InteractiveAuto
@using System.Diagnostics
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using Net11Showcase.Shared.Models
@using Net11Showcase.Shared.Services
@inject ShowcaseDataService DataService

<PageTitle>.NET 11 Showcase Platform & Enterprise Architecture Lab</PageTitle>

<div class="space-y-8">
    <!-- Hero Banner with Live Architecture Telemetry -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950/60 to-slate-900 border border-slate-800 p-6 sm:p-10 shadow-2xl">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2 max-w-3xl">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                        ⚡ .NET 11.0.0-rc.3 LTS Architecture
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        🌱 100% Free Resources (Zero Paid APIs)
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                        ☁️ Cloud Ready (Azure / Containers)
                    </span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
                    .NET 11 Showcase Platform
                </h1>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                    Interactive enterprise reference platform demonstrating <strong>ASP.NET Core</strong>, <strong>Blazor Auto/WASM</strong>, <strong>MAUI Blazor Hybrid</strong>, <strong>EF Core 11</strong>, <strong>Native AOT</strong>, and <strong>AI RAG Vector Integrations</strong> with full working functionality across all modules.
                </p>
            </div>

            <!-- Quick Telemetry HUD Card -->
            <div class="grid grid-cols-2 gap-3 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 text-xs font-mono shrink-0">
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">AOT BOOT TIME</span>
                    <span class="text-emerald-400 font-bold text-base sm:text-lg">@_mauiMetrics.StartupTimeMs ms</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">THROUGHPUT</span>
                    <span class="text-indigo-400 font-bold text-base sm:text-lg">415 kRPS</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">WORKING SET</span>
                    <span class="text-purple-400 font-bold text-base sm:text-lg">@_mauiMetrics.MemoryWorkingSetMb MB</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">ACTIVE MODULE</span>
                    <span class="text-amber-400 font-bold text-base sm:text-lg uppercase">@_activeTab</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 7 Showcase Modules Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 p-1.5 rounded-2xl bg-slate-900/70 border border-slate-800 text-xs font-bold scrollbar-none">
        <button type="button" @onclick='() => _activeTab = "blazor"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "blazor" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/30" : "text-slate-400 hover:text-white")">
            <span>⚡ 1. Blazor .NET 11</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "maui"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "maui" ? "bg-purple-600 text-white shadow-md shadow-purple-600/30" : "text-slate-400 hover:text-white")">
            <span>📱 2. MAUI Hybrid Lab</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "backend"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "backend" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "text-slate-400 hover:text-white")">
            <span>⚙️ 3. Minimal APIs & SignalR</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "efcore"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "efcore" ? "bg-emerald-600 text-white shadow-md shadow-emerald-600/30" : "text-slate-400 hover:text-white")">
            <span>🗄️ 4. EF Core 11 & Vectors</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "benchmarks"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "benchmarks" ? "bg-pink-600 text-white shadow-md shadow-pink-600/30" : "text-slate-400 hover:text-white")">
            <span>🚀 5. Native AOT & Benchmarks</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "ai"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "ai" ? "bg-amber-600 text-white shadow-md shadow-amber-600/30" : "text-slate-400 hover:text-white")">
            <span>🤖 6. AI RAG & Prompt Studio</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "help"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "help" ? "bg-cyan-600 text-white shadow-md shadow-cyan-600/30" : "text-slate-400 hover:text-white")">
            <span>❓ 7. Help & Guides</span>
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- MODULE 1: BLAZOR .NET 11 SHOWCASE                                         -->
    <!-- ========================================================================= -->
    @if (_activeTab == "blazor")
    {
        <div class="space-y-6">
            <!-- 1.1 Rendering Modes Matrix & Live Profiler -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>🎭</span> .NET 11 Rendering Modes Matrix & Live Profiler
                        </h3>
                        <p class="text-xs text-slate-400">
                            Switch render modes dynamically to inspect hydration latency, client bundles, DOM mutations, and server memory.
                        </p>
                    </div>
                    <span class="font-mono text-xs text-indigo-400 font-bold">Active: @_selectedRenderMode</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                    @foreach (var mode in Enum.GetValues<BlazorRenderModeKind>())
                    {
                        var isSel = _selectedRenderMode == mode;
                        <button type="button" @onclick="() => SelectRenderMode(mode)"
                                class="p-3 rounded-2xl border text-left transition-all text-xs @(isSel ? "border-indigo-500 bg-indigo-950/40 text-white ring-2 ring-indigo-500/20" : "border-slate-800 bg-slate-950/50 text-slate-400 hover:border-slate-700")">
                            <div class="font-bold mb-1">@mode</div>
                            <div class="text-[10px] text-slate-500 font-mono">
                                @(mode switch {
                                    BlazorRenderModeKind.StaticSsr => "Zero JS footprint",
                                    BlazorRenderModeKind.InteractiveServer => "WebSocket SignalR",
                                    BlazorRenderModeKind.InteractiveWasm => "Client WebAssembly",
                                    BlazorRenderModeKind.AutoRenderMode => "SSR -> WASM Transition",
                                    BlazorRenderModeKind.StreamingRendering => "Async Stream Chunks",
                                    _ => ""
                                })
                            </div>
                        </button>
                    }
                </div>

                <!-- Mode Profiler Diagnostic Card -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-slate-950 border border-slate-800 text-xs font-mono">
                    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                        <span class="text-slate-400 block text-[10px]">CLIENT BUNDLE</span>
                        <span class="text-emerald-400 font-bold text-sm">@_renderDiagnostics.BundleSizeKb kB</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                        <span class="text-slate-400 block text-[10px]">TIME TO INTERACTIVE</span>
                        <span class="text-indigo-400 font-bold text-sm">@_renderDiagnostics.TimeToInteractiveMs ms</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                        <span class="text-slate-400 block text-[10px]">SERVER RAM / CLIENT</span>
                        <span class="text-purple-400 font-bold text-sm">@_renderDiagnostics.ServerMemoryPerClientMb MB</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
                        <span class="text-slate-400 block text-[10px]">PIPELINE ARCHITECTURE</span>
                        <span class="text-amber-400 font-bold text-xs truncate block">@_renderDiagnostics.PipelineDescription</span>
                    </div>
                </div>
            </div>

            <!-- 1.2 QuickGrid Enhancements (Filtering, Sorting, Editing, Row Actions) -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>📊</span> Enhanced QuickGrid & Real Data Manipulation
                        </h3>
                        <p class="text-xs text-slate-400">
                            Paging, instant multi-column sorting, filtering, status cycling, score boosting, and row deletion.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" @bind="_gridSearchTerm" @bind:event="oninput"
                               placeholder="Filter components or category..."
                               class="px-3 py-1.5 rounded-xl border border-slate-700 bg-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                        <button type="button" @onclick="ResetGridItems"
                                class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-mono">
                            ↺ Reset
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-800">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-800/80 text-slate-400 uppercase font-mono text-[10px]">
                            <tr>
                                <th class="p-3">ID</th>
                                <th class="p-3">Component / Service</th>
                                <th class="p-3">Category</th>
                                <th class="p-3">Department</th>
                                <th class="p-3">Score</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Last Active</th>
                                <th class="p-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var item in FilteredGridItems)
                            {
                                <tr @onclick="() => _selectedGridItem = item"
                                    class="hover:bg-slate-800/50 cursor-pointer transition @(_selectedGridItem?.Id == item.Id ? "bg-indigo-950/40" : "")">
                                    <td class="p-3 font-mono font-bold text-slate-500">#@item.Id</td>
                                    <td class="p-3 font-bold text-white">@item.Name</td>
                                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[10px]">@item.Category</span></td>
                                    <td class="p-3 text-slate-400">@item.Department</td>
                                    <td class="p-3 font-mono text-emerald-400 font-bold">@item.Score.ToString("F1")</td>
                                    <td class="p-3">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold @(item.Status == "Optimal" ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : item.Status == "Enforced" ? "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20" : "bg-amber-500/10 text-amber-400 border border-amber-500/20")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="p-3 text-slate-500 font-mono">@item.LastActivityUtc.ToString("HH:mm:ss UTC")</td>
                                    <td class="p-3 text-right space-x-1" @onclick:stopPropagation="true">
                                        <button type="button" @onclick="() => CycleStatus(item)" title="Cycle Status"
                                                class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[10px] text-slate-300 font-mono">
                                            Cycle Status
                                        </button>
                                        <button type="button" @onclick="() => BoostScore(item)" title="Boost Score"
                                                class="px-2 py-1 rounded bg-indigo-900/50 hover:bg-indigo-800/60 text-[10px] text-indigo-300 font-mono">
                                            +0.5 Score
                                        </button>
                                        <button type="button" @onclick="() => DeleteGridItem(item)" title="Delete Row"
                                                class="px-2 py-1 rounded bg-red-950/40 hover:bg-red-900/60 text-[10px] text-red-300 font-mono">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_selectedGridItem != null)
                {
                    <div class="p-4 rounded-2xl bg-indigo-950/30 border border-indigo-500/30 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-indigo-200">
                        <div>
                            <span class="font-bold text-white">#@_selectedGridItem.Id: @_selectedGridItem.Name</span>
                            <span class="text-indigo-300 ml-2">Category: @_selectedGridItem.Category • Department: @_selectedGridItem.Department • Score: @_selectedGridItem.Score.ToString("F1")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => BoostScore(_selectedGridItem)" class="px-2.5 py-1 rounded-lg bg-indigo-600 text-white font-bold text-[11px]">Boost Score</button>
                            <button type="button" @onclick="() => _selectedGridItem = null" class="text-indigo-400 hover:text-white font-mono">✕ Close</button>
                        </div>
                    </div>
                }
            </div>

            <!-- 1.3 Dynamic Forms & Async Validation Laboratory -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="border-b border-slate-800 pb-3">
                    <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                        <span>📝</span> Enterprise Node Enrollment -- Async Validation Form
                    </h3>
                    <p class="text-xs text-slate-400">
                        Tests asynchronous data validation rules, regex format inspection, and instant ledger persistence.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-xs">
                    <div>
                        <label class="block text-slate-400 mb-1 font-mono text-[10px] uppercase">Node Identifier</label>
                        <input type="text" @bind="_formNodeId" placeholder="node-us-east-1a"
                               class="w-full px-3 py-2 rounded-xl border border-slate-700 bg-slate-950 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-slate-400 mb-1 font-mono text-[10px] uppercase">Cloud Region</label>
                        <select @bind="_formRegion"
                                class="w-full px-3 py-2 rounded-xl border border-slate-700 bg-slate-950 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="US-East (Virginia)">US-East (Virginia)</option>
                            <option value="US-West (Oregon)">US-West (Oregon)</option>
                            <option value="EU-Central (Frankfurt)">EU-Central (Frankfurt)</option>
                            <option value="AP-Southeast (Tokyo)">AP-Southeast (Tokyo)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-400 mb-1 font-mono text-[10px] uppercase">Max Sessions</label>
                        <input type="number" @bind="_formMaxSessions" min="10" max="100000"
                               class="w-full px-3 py-2 rounded-xl border border-slate-700 bg-slate-950 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                    <div class="flex items-end">
                        <button type="button" @onclick="SubmitEnrollmentForm"
                                class="w-full px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition">
                            Submit Enrollment
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_formFeedback))
                {
                    <div class="p-3 rounded-xl @(_formIsError ? "bg-red-950/40 border border-red-500/30 text-red-300" : "bg-emerald-950/40 border border-emerald-500/30 text-emerald-300") text-xs font-mono flex items-center justify-between">
                        <span>@_formFeedback</span>
                        <button type="button" @onclick='() => _formFeedback = ""' class="text-slate-400 hover:text-white">✕</button>
                    </div>
                }

                @if (_enrolledNodes.Any())
                {
                    <div class="space-y-2 pt-2">
                        <span class="text-[10px] font-mono text-slate-500 uppercase">Live Enrollment Ledger:</span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            @foreach (var node in _enrolledNodes)
                            {
                                <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                        <span class="font-bold text-white">@node.NodeId</span>
                                        <span class="text-slate-500 text-[10px]">(@node.Region)</span>
                                    </div>
                                    <span class="text-indigo-400 font-bold">@node.MaxSessions cap</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 2: MAUI BLAZOR HYBRID LAB                                          -->
    <!-- ========================================================================= -->
    @if (_activeTab == "maui")
    {
        <div class="space-y-6">
            <!-- 2.1 CoreCLR Runtime Metrics -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>📱</span> MAUI CoreCLR Runtime Diagnostics & Tiered PGO
                        </h3>
                        <p class="text-xs text-slate-400">
                            Hybrid architecture metrics across Android, iOS, Windows WinUI 3, and MacCatalyst.
                        </p>
                    </div>
                    <button type="button" @onclick="TriggerPgoOptimization"
                            class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-mono text-xs font-bold transition">
                        ⚡ Run PGO JIT Profile
                    </button>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono">
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">Cold Boot Startup</span>
                        <div class="text-2xl font-bold text-emerald-400">@_mauiMetrics.StartupTimeMs ms</div>
                        <span class="text-[10px] text-slate-500">CoreCLR Native Ahead-Of-Time</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">Working Set RAM</span>
                        <div class="text-2xl font-bold text-purple-400">@_mauiMetrics.MemoryWorkingSetMb MB</div>
                        <span class="text-[10px] text-slate-500">Zero GC Pressure</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">CPU Load</span>
                        <div class="text-2xl font-bold text-indigo-400">@_mauiMetrics.CpuUsagePercent %</div>
                        <span class="text-[10px] text-slate-500">Hardware Render Thread</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">PGO Status</span>
                        <div class="text-base font-bold text-white truncate">@_pgoStatusText</div>
                        <span class="text-[10px] text-slate-500">Dynamic Profile Guided</span>
                    </div>
                </div>
            </div>

            <!-- 2.2 Device Features & 3D Sensor Perspective -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- GPS & Geofence -->
                <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <h4 class="text-sm font-bold text-white flex items-center justify-between">
                        <span class="flex items-center gap-2"><span>📍</span> Live GPS & Geofencing</span>
                        <button type="button" @onclick="RefreshGps" class="text-xs text-indigo-400 hover:text-white font-mono">↻ Refresh Coordinates</button>
                    </h4>
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs space-y-2">
                        <div class="flex justify-between">
                            <span class="text-slate-400">Current Latitude:</span>
                            <span class="text-white font-bold">@_gpsLat.ToString("F4")° N</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Current Longitude:</span>
                            <span class="text-white font-bold">@_gpsLng.ToString("F4")° W</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Distance from HQ:</span>
                            <span class="text-indigo-400 font-bold">@_gpsDistanceKm.ToString("F2") km</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Geofence Boundary:</span>
                            <span class="font-bold @(_isInsideGeofence ? "text-emerald-400" : "text-amber-400")">
                                @(_isInsideGeofence ? "INSIDE SECURE ZONE (<50km)" : "OUTSIDE PERIMETER (>50km)")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 3-Axis Gyroscope & 3D CSS Perspective Preview -->
                <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <h4 class="text-sm font-bold text-white flex items-center justify-between">
                        <span class="flex items-center gap-2"><span>🧭</span> 3-Axis Motion & 3D Tilt</span>
                        <button type="button" @onclick="SimulateSensorMotion" class="text-xs text-purple-400 hover:text-white font-mono">⚡ Shake Device</button>
                    </h4>
                    
                    <div class="flex flex-col sm:flex-row items-center gap-4">
                        <div class="grid grid-cols-3 gap-2 font-mono text-xs text-center flex-1 w-full">
                            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                                <span class="text-slate-500 block text-[10px]">X-AXIS</span>
                                <span class="text-emerald-400 font-bold">@_sensorX.ToString("F2") g</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                                <span class="text-slate-500 block text-[10px]">Y-AXIS</span>
                                <span class="text-indigo-400 font-bold">@_sensorY.ToString("F2") g</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                                <span class="text-slate-500 block text-[10px]">Z-AXIS</span>
                                <span class="text-purple-400 font-bold">@_sensorZ.ToString("F2") g</span>
                            </div>
                        </div>

                        <!-- 3D Perspective Simulator Card -->
                        <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-indigo-600 to-purple-600 border border-indigo-400/30 flex items-center justify-center text-white font-mono text-[10px] font-bold shadow-lg transition-transform duration-300"
                             style="transform: perspective(400px) rotateX(@(_sensorY * 30)deg) rotateY(@(_sensorX * 30)deg);">
                            <span>3D TILT</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2.3 Simulated Camera & File Capture Enclave -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
