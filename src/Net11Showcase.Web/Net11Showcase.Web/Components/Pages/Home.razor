                    <span class="text-slate-500 text-[10px] uppercase block">Generated EF Core SQL:</span>
                    <code class="text-indigo-400">@_generatedSqlPreview</code>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 5: NATIVE AOT & BENCHMARK LAB                                      -->
    <!-- ========================================================================= -->
    @if (_activeTab == "benchmarks")
    {
        <div class="space-y-6">
            <!-- 5.1 Multi-Version Comparison Table -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
