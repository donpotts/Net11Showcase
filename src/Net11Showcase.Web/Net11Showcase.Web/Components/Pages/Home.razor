                                <div class="flex items-center justify-between text-white font-bold">
                                    <span>@file.FileName</span>
                                    <span class="text-emerald-400">@file.SizeKb kB</span>
                                </div>
                                <div class="text-[10px] text-slate-500 truncate">SHA-256: @file.Sha256Digest</div>
                                <div class="text-[10px] text-slate-400">Captured: @file.TimestampUtc.ToString("HH:mm:ss UTC")</div>
                            </div>
                        }
                    </div>
