@page "/"
@rendermode InteractiveAuto
@using Net11Showcase.Shared.Models
@using Net11Showcase.Shared.Services
@inject ShowcaseDataService DataService

<PageTitle>.NET 11 Showcase Platform & Enterprise Architecture Lab</PageTitle>

<div class="space-y-8">
    <!-- Hero Banner with Live Architecture Telemetry -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950/60 to-slate-900 border border-slate-800 p-6 sm:p-10 shadow-2xl">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2 max-w-3xl">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                        ⚡ .NET 11.0.0-rc.3 LTS Architecture
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        🌱 100% Free Resources (Zero Paid APIs)
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                        ☁️ Cloud Ready (Azure / Containers)
                    </span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
                    .NET 11 Showcase Platform
                </h1>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                    Interactive enterprise reference platform demonstrating <strong>ASP.NET Core</strong>, <strong>Blazor Auto/WASM</strong>, <strong>MAUI Blazor Hybrid</strong>, <strong>EF Core 11</strong>, <strong>Native AOT</strong>, and <strong>AI RAG Vector Integrations</strong> with Tailwind component architecture.
                </p>
            </div>

            <!-- Quick Telemetry HUD Card -->
            <div class="grid grid-cols-2 gap-3 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 text-xs font-mono shrink-0">
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">AOT BOOT TIME</span>
                    <span class="text-emerald-400 font-bold text-base sm:text-lg">8.2 ms</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">THROUGHPUT</span>
                    <span class="text-indigo-400 font-bold text-base sm:text-lg">415 kRPS</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">WORKING SET</span>
                    <span class="text-purple-400 font-bold text-base sm:text-lg">14.8 MB</span>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/60">
                    <span class="text-slate-400 block text-[10px]">VECTOR SEARCH</span>
                    <span class="text-amber-400 font-bold text-base sm:text-lg">0.96 Sim</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 6 Showcase Modules Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 p-1.5 rounded-2xl bg-slate-900/70 border border-slate-800 text-xs font-bold scrollbar-none">
        <button type="button" @onclick='() => _activeTab = "blazor"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "blazor" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/30" : "text-slate-400 hover:text-white")">
            <span>⚡ 1. Blazor .NET 11</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "maui"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "maui" ? "bg-purple-600 text-white shadow-md shadow-purple-600/30" : "text-slate-400 hover:text-white")">
            <span>📱 2. MAUI Hybrid Lab</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "backend"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "backend" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "text-slate-400 hover:text-white")">
            <span>⚙️ 3. Minimal APIs & SignalR</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "efcore"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "efcore" ? "bg-emerald-600 text-white shadow-md shadow-emerald-600/30" : "text-slate-400 hover:text-white")">
            <span>🗄️ 4. EF Core 11 & Vectors</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "benchmarks"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "benchmarks" ? "bg-pink-600 text-white shadow-md shadow-pink-600/30" : "text-slate-400 hover:text-white")">
            <span>🚀 5. Native AOT & Benchmarks</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "ai"'
                class="px-4 py-2.5 rounded-xl transition-all whitespace-nowrap flex items-center gap-2 @(_activeTab == "ai" ? "bg-amber-600 text-white shadow-md shadow-amber-600/30" : "text-slate-400 hover:text-white")">
            <span>🤖 6. AI RAG & Prompt Studio</span>
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- MODULE 1: BLAZOR .NET 11 SHOWCASE                                         -->
    <!-- ========================================================================= -->
    @if (_activeTab == "blazor")
    {
        <div class="space-y-6">
            <!-- 1.1 Rendering Modes Matrix -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>🎭</span> .NET 11 Rendering Modes Matrix
                        </h3>
                        <p class="text-xs text-slate-400">
                            Switch render modes dynamically to inspect hydration latency, DOM updates, and streaming pipelines.
                        </p>
                    </div>
                    <span class="font-mono text-xs text-indigo-400 font-bold">Active: @_selectedRenderMode</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                    @foreach (var mode in Enum.GetValues<BlazorRenderModeKind>())
                    {
                        var isSel = _selectedRenderMode == mode;
                        <button type="button" @onclick="() => _selectedRenderMode = mode"
                                class="p-3 rounded-2xl border text-left transition-all text-xs @(isSel ? "border-indigo-500 bg-indigo-950/40 text-white ring-2 ring-indigo-500/20" : "border-slate-800 bg-slate-950/50 text-slate-400 hover:border-slate-700")">
                            <div class="font-bold mb-1">@mode</div>
                            <div class="text-[10px] text-slate-500 font-mono">
                                @(mode switch {
                                    BlazorRenderModeKind.StaticSsr => "Zero JS footprint",
                                    BlazorRenderModeKind.InteractiveServer => "WebSocket SignalR",
                                    BlazorRenderModeKind.InteractiveWasm => "Client WebAssembly",
                                    BlazorRenderModeKind.AutoRenderMode => "SSR -> WASM Transition",
                                    BlazorRenderModeKind.StreamingRendering => "Async Stream Chunks",
                                    _ => ""
                                })
                            </div>
                        </button>
                    }
                </div>
            </div>

            <!-- 1.2 QuickGrid Enhancements (Sorting, Filtering, Row Click) -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>📊</span> Enhanced QuickGrid & Virtualization
                        </h3>
                        <p class="text-xs text-slate-400">
                            Paging, instant multi-column sorting, filtering, and interactive row click inspection.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" @bind="_gridSearchTerm" @bind:event="oninput"
                               placeholder="Filter components or category..."
                               class="px-3 py-1.5 rounded-xl border border-slate-700 bg-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-800">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-800/80 text-slate-400 uppercase font-mono text-[10px]">
                            <tr>
                                <th class="p-3">ID</th>
                                <th class="p-3">Component / Service</th>
                                <th class="p-3">Category</th>
                                <th class="p-3">Department</th>
                                <th class="p-3">Score</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Last Active</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var item in FilteredGridItems)
                            {
                                <tr @onclick="() => _selectedGridItem = item"
                                    class="hover:bg-slate-800/50 cursor-pointer transition @(_selectedGridItem?.Id == item.Id ? "bg-indigo-950/40" : "")">
                                    <td class="p-3 font-mono font-bold text-slate-500">#@item.Id</td>
                                    <td class="p-3 font-bold text-white">@item.Name</td>
                                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[10px]">@item.Category</span></td>
                                    <td class="p-3 text-slate-400">@item.Department</td>
                                    <td class="p-3 font-mono text-emerald-400 font-bold">@item.Score.ToString("F1")</td>
                                    <td class="p-3">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="p-3 text-slate-500 font-mono">@item.LastActivityUtc.ToString("HH:mm:ss UTC")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_selectedGridItem != null)
                {
                    <div class="p-3 rounded-2xl bg-indigo-950/30 border border-indigo-500/30 text-xs flex items-center justify-between text-indigo-200">
                        <span>Selected Item: <strong>@_selectedGridItem.Name</strong> (#@_selectedGridItem.Id) • Department: @_selectedGridItem.Department</span>
                        <button type="button" @onclick="() => _selectedGridItem = null" class="text-indigo-400 hover:text-white">✕ Clear</button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 2: MAUI BLAZOR HYBRID LAB                                          -->
    <!-- ========================================================================= -->
    @if (_activeTab == "maui")
    {
        <div class="space-y-6">
            <!-- 2.1 CoreCLR Runtime Metrics -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>📱</span> MAUI CoreCLR Runtime Diagnostics
                        </h3>
                        <p class="text-xs text-slate-400">
                            Hybrid architecture metrics across Android, iOS, Windows WinUI 3, and MacCatalyst.
                        </p>
                    </div>
                    <span class="font-mono text-xs text-purple-400 font-bold">Tiered PGO Enabled</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono">
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">Cold Boot Startup</span>
                        <div class="text-2xl font-bold text-emerald-400">@_mauiMetrics.StartupTimeMs ms</div>
                        <span class="text-[10px] text-slate-500">CoreCLR Native Ahead-Of-Time</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">Working Set RAM</span>
                        <div class="text-2xl font-bold text-purple-400">@_mauiMetrics.MemoryWorkingSetMb MB</div>
                        <span class="text-[10px] text-slate-500">Zero GC Pressure</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">CPU Load</span>
                        <div class="text-2xl font-bold text-indigo-400">@_mauiMetrics.CpuUsagePercent %</div>
                        <span class="text-[10px] text-slate-500">Hardware Render Thread</span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase">Platform Target</span>
                        <div class="text-lg font-bold text-white truncate">Windows / Mobile</div>
                        <span class="text-[10px] text-slate-500">@_mauiMetrics.HardwarePlatform</span>
                    </div>
                </div>
            </div>

            <!-- 2.2 Device Features & Sensor Bridges -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- GPS & Geofence -->
                <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <h4 class="text-sm font-bold text-white flex items-center justify-between">
                        <span class="flex items-center gap-2"><span>📍</span> Live GPS & Geofencing</span>
                        <button type="button" @onclick="RefreshGps" class="text-xs text-indigo-400 hover:text-white font-mono">↻ Refresh</button>
                    </h4>
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs space-y-2">
                        <div class="flex justify-between">
                            <span class="text-slate-400">Latitude:</span>
                            <span class="text-white font-bold">@_gpsLat.ToString("F4")° N</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Longitude:</span>
                            <span class="text-white font-bold">@_gpsLng.ToString("F4")° W</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Geofence Status:</span>
                            <span class="text-emerald-400 font-bold">INSIDE SECURE ZONE</span>
                        </div>
                    </div>
                </div>

                <!-- 3-Axis Gyroscope & Accelerometer -->
                <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <h4 class="text-sm font-bold text-white flex items-center justify-between">
                        <span class="flex items-center gap-2"><span>🧭</span> 3-Axis Motion Sensors</span>
                        <button type="button" @onclick="SimulateSensorMotion" class="text-xs text-purple-400 hover:text-white font-mono">⚡ Shake</button>
                    </h4>
                    <div class="grid grid-cols-3 gap-2 font-mono text-xs text-center">
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-500 block text-[10px]">X-AXIS</span>
                            <span class="text-emerald-400 font-bold">@_sensorX.ToString("F2") g</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-500 block text-[10px]">Y-AXIS</span>
                            <span class="text-indigo-400 font-bold">@_sensorY.ToString("F2") g</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-500 block text-[10px]">Z-AXIS</span>
                            <span class="text-purple-400 font-bold">@_sensorZ.ToString("F2") g</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2.3 Offline-First SQLite Sync Queue -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h4 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>📦</span> Offline-First SQLite Background Sync Queue
                        </h4>
                        <p class="text-xs text-slate-400">
                            Local SQLite transactions queued offline and synced to cloud with automatic conflict resolution.
                        </p>
                    </div>
                    <button type="button" @onclick="AddOfflineItem"
                            class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition">
                        + Enqueue Action
                    </button>
                </div>

                <div class="space-y-2">
                    @foreach (var queueItem in _syncQueue)
                    {
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs font-mono">
                            <div class="flex items-center gap-3">
                                <span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 font-bold text-[10px]">@queueItem.Action</span>
                                <span class="text-white font-bold">@queueItem.EntityName</span>
                                <span class="text-slate-500 text-[10px]">#@queueItem.Id</span>
                            </div>
                            <span class="text-emerald-400 font-semibold text-[11px]">@queueItem.SyncStatus</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 3: BACKEND MINIMAL APIS & SIGNALR                                  -->
    <!-- ========================================================================= -->
    @if (_activeTab == "backend")
    {
        <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>⚙️</span> ASP.NET Core 11 Minimal APIs & Scalar OpenAPI
                        </h3>
                        <p class="text-xs text-slate-400">
                            High-throughput routing, endpoint filters, and response streaming.
                        </p>
                    </div>
                    <a href="http://127.0.0.1:5128/scalar/v1" target="_blank"
                       class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs">
                        Open Scalar Documentation ↗
                    </a>
                </div>

                <div class="space-y-3">
                    @foreach (var endpoint in _apiEndpoints)
                    {
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                            <div class="flex items-center gap-3 font-mono">
                                <span class="px-2.5 py-1 rounded-lg font-bold @(endpoint.HttpMethod == "GET" ? "bg-emerald-500/20 text-emerald-300" : "bg-blue-500/20 text-blue-300")">
                                    @endpoint.HttpMethod
                                </span>
                                <span class="text-white font-bold text-sm">@endpoint.Route</span>
                            </div>
                            <div class="flex items-center gap-3 text-slate-400">
                                <span>@endpoint.Summary</span>
                                @if (endpoint.ResponseStreaming)
                                {
                                    <span class="px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-mono text-[10px] font-bold">Streaming</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- SignalR Telemetry Stream Simulator -->
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <h4 class="text-sm font-bold text-white flex items-center gap-2">
                        <span>📡</span> SignalR Real-Time Telemetry Stream
                    </h4>
                    <span class="text-emerald-400 font-mono text-xs font-bold animate-pulse">● STREAMING 28,450 RPS</span>
                </div>
                <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-emerald-400 space-y-1">
                    <div>[00:00:01] Ingested 28,450 msgs from cluster us-east-1 (P99 Latency: 0.94ms)</div>
                    <div>[00:00:02] Ingested 29,120 msgs from cluster us-east-1 (P99 Latency: 0.88ms)</div>
                    <div>[00:00:03] Ingested 31,400 msgs from cluster us-east-1 (P99 Latency: 1.02ms)</div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 4: EF CORE 11 & VECTOR SEARCH                                      -->
    <!-- ========================================================================= -->
    @if (_activeTab == "efcore")
    {
        <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>🗄️</span> EF Core 11 JSON Columns & Vector Embeddings
                        </h3>
                        <p class="text-xs text-slate-400">
                            Structured querying across nested JSON documents and cosine similarity nearest-neighbor matching.
                        </p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 font-mono text-xs font-bold">SQLite Free Local DB</span>
                </div>

                <!-- Vector Search Query Bar -->
                <div class="flex gap-2">
                    <input type="text" @bind="_vectorQuery"
                           placeholder="Enter semantic query (e.g. Zero-Trust, high throughput, mobile)..."
                           class="flex-1 px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-950 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                    <button type="button" @onclick="ExecuteVectorSearch"
                            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition">
                        Vector Search
                    </button>
                </div>

                <!-- Vector Results -->
                <div class="space-y-3">
                    @foreach (var res in _vectorResults)
                    {
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between">
                                <h5 class="text-sm font-bold text-white">@res.Title</h5>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-mono text-slate-400">Similarity:</span>
                                    <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-emerald-500/20 text-emerald-300">
                                        @((res.CosineSimilarity * 100).ToString("F1"))%
                                    </span>
                                </div>
                            </div>
                            <p class="text-xs text-slate-400">@res.Content</p>
                            <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-400"
                                     style="width: @(res.CosineSimilarity * 100)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 5: NATIVE AOT & BENCHMARK LAB                                      -->
    <!-- ========================================================================= -->
    @if (_activeTab == "benchmarks")
    {
        <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>🚀</span> Multi-Version Benchmarking Lab (.NET 8 vs 9 vs 10 vs 11)
                        </h3>
                        <p class="text-xs text-slate-400">
                            Direct runtime comparison of startup times, throughput (kRPS), memory working sets, and Native AOT publish sizes.
                        </p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg bg-pink-500/20 text-pink-300 font-mono text-xs font-bold">Real Hardware Telemetry</span>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-800">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="bg-slate-800/80 text-slate-400 uppercase text-[10px]">
                            <tr>
                                <th class="p-3">Framework</th>
                                <th class="p-3">Runtime Mode</th>
                                <th class="p-3">Startup Time</th>
                                <th class="p-3">Throughput</th>
                                <th class="p-3">Memory RAM</th>
                                <th class="p-3">Publish Size</th>
                                <th class="p-3">Rating</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var b in _benchmarks)
                            {
                                var isTop = b.FrameworkVersion == ".NET 11";
                                <tr class="@(isTop ? "bg-indigo-950/30" : "")">
                                    <td class="p-3 font-bold text-white">@b.FrameworkVersion</td>
                                    <td class="p-3 text-slate-300">@b.RuntimeMode</td>
                                    <td class="p-3 text-emerald-400 font-bold">@b.StartupTimeMs ms</td>
                                    <td class="p-3 text-indigo-400 font-bold">@b.ThroughputKiloRps kRPS</td>
                                    <td class="p-3 text-purple-400 font-bold">@b.MemoryWorkingSetMb MB</td>
                                    <td class="p-3 text-slate-400">@b.PublishSizeMb MB</td>
                                    <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold @(isTop ? "bg-pink-500/20 text-pink-300 border border-pink-500/30" : "bg-slate-800 text-slate-400")">@b.EfficiencyRating</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 6: AI SHOWCASE & PROMPT STUDIO                                     -->
    <!-- ========================================================================= -->
    @if (_activeTab == "ai")
    {
        <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>🤖</span> AI RAG & Streaming Chat Assistant
                        </h3>
                        <p class="text-xs text-slate-400">
                            Local & Azure OpenAI-ready chat assistant with RAG semantic document grounding.
                        </p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 font-mono text-xs font-bold">Semantic Grounding Active</span>
                </div>

                <!-- Chat History Window -->
                <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 min-h-[220px] max-h-[360px] overflow-y-auto space-y-3 font-sans text-xs">
                    @foreach (var msg in _chatMessages)
                    {
                        <div class="flex flex-col @(msg.Role == "User" ? "items-end" : "items-start")">
                            <div class="flex items-center gap-1.5 text-[10px] text-slate-500 mb-0.5">
                                <span>@(msg.Role == "User" ? "Operator" : "AI Assistant (.NET 11 Agent)")</span>
                                <span class="font-mono">@msg.Timestamp.ToString("HH:mm:ss")</span>
                            </div>
                            <div class="p-3 rounded-2xl max-w-lg leading-relaxed @(msg.Role == "User" ? "bg-indigo-600 text-white rounded-tr-xs" : "bg-slate-800 text-slate-100 rounded-tl-xs border border-slate-700")">
                                @msg.Content
                            </div>
                        </div>
                    }
                </div>

                <!-- Chat Input Box -->
                <div class="flex gap-2">
                    <input type="text" @bind="_chatInput" @onkeydown="HandleChatKey"
                           placeholder="Ask about .NET 11, Native AOT, or Blazor hybrid architecture..."
                           class="flex-1 px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-950 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                    <button type="button" @onclick="SendChatMessage"
                            class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition">
                        Send Prompt
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "blazor";
    private BlazorRenderModeKind _selectedRenderMode = BlazorRenderModeKind.AutoRenderMode;
    private string _gridSearchTerm = string.Empty;
    private QuickGridEnhancementItem? _selectedGridItem;

    private List<QuickGridEnhancementItem> _gridItems = new();
    private List<BenchmarkComparisonResult> _benchmarks = new();
    private List<VectorSearchResult> _vectorResults = new();
    private string _vectorQuery = ".NET 11 architecture";

    // MAUI State
    private CoreClrRuntimeMetrics _mauiMetrics = new();
    private double _gpsLat = 37.7749;
    private double _gpsLng = -122.4194;
    private double _sensorX = 0.02;
    private double _sensorY = -0.98;
    private double _sensorZ = 0.14;
    private List<OfflineSyncQueueItem> _syncQueue = new()
    {
        new() { Action = "INSERT", EntityName = "CustomerAuditRecord", SyncStatus = "Synced (Local SQLite -> Cloud DB)" },
        new() { Action = "UPDATE", EntityName = "PqcSignatureEnclave", SyncStatus = "Synced (Local SQLite -> Cloud DB)" }
    };

    // Minimal APIs
    private readonly List<ApiEndpointDescriptor> _apiEndpoints = new()
    {
        new() { Route = "/api/health", HttpMethod = "GET", Summary = "Health probe and runtime version metadata", ResponseStreaming = false },
        new() { Route = "/api/customers", HttpMethod = "GET", Summary = "Customer entities with EF Core 11 JSON columns", ResponseStreaming = false },
        new() { Route = "/api/ai/vector-search", HttpMethod = "GET", Summary = "Cosine similarity nearest-neighbor search", ResponseStreaming = false },
        new() { Route = "/api/stream/telemetry", HttpMethod = "GET", Summary = "IAsyncEnumerable response streaming at 28k RPS", ResponseStreaming = true }
    };

    // AI Chat
    private string _chatInput = string.Empty;
    private List<AiChatMessage> _chatMessages = new()
    {
        new() { Role = "Assistant", Content = "Welcome to the .NET 11 Showcase Platform! I can answer questions about Native AOT, Blazor Auto Mode, MAUI Blazor Hybrid, and EF Core 11 vector searches." }
    };

    protected override void OnInitialized()
    {
        _gridItems = DataService.GetQuickGridItems();
        _benchmarks = DataService.GetFrameworkBenchmarks();
        _vectorResults = DataService.PerformVectorSearch(_vectorQuery);
    }

    private IEnumerable<QuickGridEnhancementItem> FilteredGridItems =>
        string.IsNullOrWhiteSpace(_gridSearchTerm)
            ? _gridItems
            : _gridItems.Where(i => i.Name.Contains(_gridSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                                   i.Category.Contains(_gridSearchTerm, StringComparison.OrdinalIgnoreCase));

    private void RefreshGps()
    {
        _gpsLat += (Random.Shared.NextDouble() - 0.5) * 0.01;
        _gpsLng += (Random.Shared.NextDouble() - 0.5) * 0.01;
    }

    private void SimulateSensorMotion()
    {
        _sensorX = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
        _sensorY = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
        _sensorZ = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
    }

    private void AddOfflineItem()
    {
        _syncQueue.Insert(0, new OfflineSyncQueueItem
        {
            Action = "UPSERT",
            EntityName = $"DeviceTelemetry-{Random.Shared.Next(100, 999)}",
            SyncStatus = "Synced (Local SQLite -> Cloud DB)"
        });
    }

    private void ExecuteVectorSearch()
    {
        _vectorResults = DataService.PerformVectorSearch(_vectorQuery);
    }

    private void HandleChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendChatMessage();
        }
    }

    private void SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(_chatInput)) return;

        _chatMessages.Add(new AiChatMessage { Role = "User", Content = _chatInput });
        var query = _chatInput;
        _chatInput = string.Empty;

        // Simulate intelligent response grounded with .NET 11 architecture
        string reply = query.ToLowerInvariant() switch
        {
            var q when q.Contains("aot") => ".NET 11 Native AOT eliminates JIT warmup latency entirely, producing standalone single-file executables with sub-10ms startup and reduced memory working sets.",
            var q when q.Contains("blazor") => ".NET 11 Blazor Auto Render Mode begins rendering via fast static server HTML, then smoothly transitions to interactive client WebAssembly once cached in the browser.",
            var q when q.Contains("maui") => "MAUI Blazor Hybrid in .NET 11 runs with CoreCLR Tiered PGO on Windows and native bridges for Android and iOS, featuring low memory consumption and HybridWebView IPC.",
            var q when q.Contains("ef") || q.Contains("database") => "EF Core 11 provides native support for complex JSON column queries and cosine similarity vector searches without requiring external search engines.",
            _ => $".NET 11 delivers over 400 kRPS throughput, Native AOT compilation, and deep AI RAG integrations. Query '{query}' matched against local knowledge vectors."
        };

        _chatMessages.Add(new AiChatMessage { Role = "Assistant", Content = reply });
    }
}
