                            class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-[11px]">
                        Blazor Auto Mode
                    </button>
                    <button type="button" @onclick='() => SendSuggestedPrompt("How does EF Core 11 handle JSON columns and cosine vector similarity?")'
                            class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-[11px]">
                        EF Core Vectors
                    </button>
                </div>

                <!-- Chat Input Box -->
                <div class="flex gap-2">
                    <input type="text" @bind="_chatInput" @onkeydown="HandleChatKey"
                           placeholder="Ask about .NET 11, Native AOT, or Blazor hybrid architecture..."
                           class="flex-1 px-4 py-2.5 rounded-xl border border-slate-700 bg-slate-950 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                    <button type="button" @onclick="SendChatMessage"
                            class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition">
                        Send Prompt
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MODULE 7: HELP, GUIDES & DOCUMENTATION                                    -->
    <!-- ========================================================================= -->
    @if (_activeTab == "help")
    {
        <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-6">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                            <span>❓</span> System Help, Architectural Guides & FAQ
                        </h3>
                        <p class="text-xs text-slate-400">
                            Pre-flight launcher instructions, troubleshooting port conflicts, offline SQLite mode, and cloud deployment guides.
                        </p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 font-mono text-xs font-bold">100% Free Resources</span>
                </div>

                <!-- 4 Quick Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="font-bold text-white text-sm flex items-center gap-2">
                            <span class="text-cyan-400">⚡</span> Port Coordinator & Pre-Flight Probing
                        </div>
                        <p class="text-slate-400 leading-relaxed">
                            The launcher (<code class="text-cyan-300">launch-showcase.ps1</code> / <code class="text-cyan-300">launch-showcase.cmd</code>) automatically probes TCP ports from <code class="text-white">5150</code> to <code class="text-white">5250</code>, binds an unoccupied socket, and waits for <code class="text-emerald-400 font-mono">HTTP 200 OK</code> before launching your browser.
                        </p>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="font-bold text-white text-sm flex items-center gap-2">
                            <span class="text-purple-400">🌱</span> 100% Free Foundation
                        </div>
                        <p class="text-slate-400 leading-relaxed">
                            Requires zero paid API keys, zero subscription cloud licenses, and zero external database engines. Local SQLite file (<code class="text-purple-300">showcase_net11.db</code>) and high-performance in-memory vector cosine math provide complete functionality out of the box.
                        </p>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="font-bold text-white text-sm flex items-center gap-2">
                            <span class="text-emerald-400">☁️</span> Cloud Extension Points
                        </div>
                        <p class="text-slate-400 leading-relaxed">
                            Toggle Azure App Service (F1 $0 tier), Azure SQL, or Azure OpenAI anytime by updating standard connection strings in <code class="text-emerald-300">src/Net11Showcase.Api/appsettings.json</code>.
                        </p>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="font-bold text-white text-sm flex items-center gap-2">
                            <span class="text-pink-400">🖥️</span> Windows Installer
                        </div>
                        <p class="text-slate-400 leading-relaxed">
                            Run <code class="text-pink-300">Install-Net11Showcase.cmd</code> to install the pre-compiled Release distribution to <code class="text-white">%LOCALAPPDATA%\Net11Showcase</code> with Desktop and Start Menu shortcuts and a clean one-click uninstaller.
                        </p>
                    </div>
                </div>

                <!-- CLI Cheat Sheet Table -->
                <div class="space-y-2">
                    <h4 class="text-xs font-mono font-bold text-slate-300 uppercase">CLI Command Quick Reference</h4>
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 space-y-2">
                        <div class="flex justify-between border-b border-slate-800 pb-1.5 text-slate-500 text-[10px]">
                            <span>OPERATION</span>
                            <span>COMMAND</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                            <span class="text-slate-400">Install Suite:</span>
                            <span class="text-cyan-300">.\Install-Net11Showcase.cmd</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                            <span class="text-slate-400">Launch with Port Coordinator:</span>
                            <span class="text-emerald-300">.\launch-showcase.ps1 -StartPort 5150</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                            <span class="text-slate-400">Run xUnit Tests:</span>
                            <span class="text-indigo-300">dotnet test Net11Showcase.slnx</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                            <span class="text-slate-400">Interactive E2E Test:</span>
                            <span class="text-pink-300">python scratch/test_net11_showcase_e2e.py</span>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                            <span class="text-slate-400">OpenAPI Scalar Console:</span>
                            <span class="text-amber-300">http://127.0.0.1:5150/scalar/v1</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "blazor";

    // 1. Blazor Module State
    private BlazorRenderModeKind _selectedRenderMode = BlazorRenderModeKind.AutoRenderMode;
    private RenderModeDiagnostics _renderDiagnostics = new(142.5, 45.0, 0.4, "Hydrates from SSR HTML -> Client WASM");
    private string _gridSearchTerm = string.Empty;
    private QuickGridEnhancementItem? _selectedGridItem;
    private List<QuickGridEnhancementItem> _gridItems = new();

    // Form state
    private string _formNodeId = "node-us-east-1a";
    private string _formRegion = "US-East (Virginia)";
    private int _formMaxSessions = 25000;
    private string _formFeedback = string.Empty;
    private bool _formIsError = false;
    private List<EnrolledClusterNode> _enrolledNodes = new();

    // 2. MAUI Module State
    private CoreClrRuntimeMetrics _mauiMetrics = new();
    private string _pgoStatusText = "Tiered PGO Enabled";
    private double _gpsLat = 37.7749;
    private double _gpsLng = -122.4194;
    private double _gpsDistanceKm = 0.0;
    private bool _isInsideGeofence = true;
    private double _sensorX = 0.08;
    private double _sensorY = -0.45;
    private double _sensorZ = 0.88;
    private List<DeviceSnapshotRecord> _capturedFiles = new();
    private List<OfflineSyncQueueItem> _syncQueue = new()
    {
        new() { Id = "001", Action = "INSERT", EntityName = "CustomerAuditRecord", SyncStatus = "Synced (Local SQLite -> Cloud DB)" },
        new() { Id = "002", Action = "UPDATE", EntityName = "PqcSignatureEnclave", SyncStatus = "Synced (Local SQLite -> Cloud DB)" }
    };

    // 3. Backend Module State
    private readonly List<ApiEndpointDescriptor> _apiEndpoints = new()
    {
        new() { Route = "/api/health", HttpMethod = "GET", Summary = "Health probe and runtime version metadata", ResponseStreaming = false },
        new() { Route = "/api/customers", HttpMethod = "GET", Summary = "Customer entities with EF Core 11 JSON columns", ResponseStreaming = false },
        new() { Route = "/api/ai/vector-search", HttpMethod = "GET", Summary = "Cosine similarity nearest-neighbor search", ResponseStreaming = false },
        new() { Route = "/api/stream/telemetry", HttpMethod = "GET", Summary = "IAsyncEnumerable response streaming at 28k RPS", ResponseStreaming = true }
    };
    private string _apiConsoleOutput = string.Empty;
    private string _lastProbedRoute = string.Empty;
    private double _lastProbeLatencyMs = 0;
    private List<StreamTickLog> _streamLogs = new();

    // 4. EF Core Module State
    private List<VectorSearchResult> _vectorResults = new();
    private string _vectorQuery = ".NET 11 architecture";
    private string _selectedJsonCategory = "All";
    private string _generatedSqlPreview = "SELECT c.Id, c.Name, c.MetadataJson FROM Customers AS c";

    // 5. Benchmarks Module State
    private List<BenchmarkComparisonResult> _benchmarks = new();
    private MicroBenchmarkResult? _microBenchResult;

    // 6. AI Chat Module State
    private double _aiTemperature = 0.3;
    private double _aiTopP = 0.9;
    private int _sessionTokens = 142;
    private string _chatInput = string.Empty;
    private List<AiChatMessage> _chatMessages = new()
    {
        new() { Role = "Assistant", Content = "Welcome to the .NET 11 Showcase Platform! I can answer questions about Native AOT, Blazor Auto Mode, MAUI Blazor Hybrid, and EF Core 11 vector searches." }
    };

    protected override void OnInitialized()
    {
        _gridItems = DataService.GetQuickGridItems();
        _benchmarks = DataService.GetFrameworkBenchmarks();
        _vectorResults = DataService.PerformVectorSearch(_vectorQuery);

        _streamLogs.Add(new StreamTickLog("[00:00:01] Ingested 28,450 msgs from cluster us-east-1 (P99: 0.94ms)", DateTime.UtcNow.AddSeconds(-3)));
        _streamLogs.Add(new StreamTickLog("[00:00:02] Ingested 29,120 msgs from cluster us-east-1 (P99: 0.88ms)", DateTime.UtcNow.AddSeconds(-2)));
        _streamLogs.Add(new StreamTickLog("[00:00:03] Ingested 31,400 msgs from cluster us-east-1 (P99: 1.02ms)", DateTime.UtcNow.AddSeconds(-1)));

        _capturedFiles.Add(new DeviceSnapshotRecord("telemetry_node_01.dat", 48.2, "d41d8cd98f00b204e9800998ecf8427e", DateTime.UtcNow.AddMinutes(-4)));
    }

    private IEnumerable<QuickGridEnhancementItem> FilteredGridItems =>
        string.IsNullOrWhiteSpace(_gridSearchTerm)
            ? _gridItems
            : _gridItems.Where(i => i.Name.Contains(_gridSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                                   i.Category.Contains(_gridSearchTerm, StringComparison.OrdinalIgnoreCase));

    // Module 1 logic
    private void SelectRenderMode(BlazorRenderModeKind mode)
    {
        _selectedRenderMode = mode;
        _renderDiagnostics = mode switch
        {
            BlazorRenderModeKind.StaticSsr => new(0.0, 12.0, 0.05, "Zero client JavaScript runtime; pure server HTML"),
            BlazorRenderModeKind.InteractiveServer => new(18.5, 32.0, 1.85, "Stateful SignalR WebSocket binary circuit"),
            BlazorRenderModeKind.InteractiveWasm => new(320.0, 95.0, 0.02, "Client WebAssembly with offline caching"),
            BlazorRenderModeKind.AutoRenderMode => new(142.5, 45.0, 0.40, "Initial Fast SSR HTML -> Client WASM Hydration"),
            BlazorRenderModeKind.StreamingRendering => new(8.4, 18.0, 0.15, "Chunked transfer encoding of async razor blocks"),
            _ => _renderDiagnostics
        };
    }

    private void ResetGridItems()
    {
        _gridItems = DataService.GetQuickGridItems();
        _gridSearchTerm = string.Empty;
        _selectedGridItem = null;
    }

    private void CycleStatus(QuickGridEnhancementItem item)
    {
        item.Status = item.Status switch
        {
            "Optimal" => "Enforced",
            "Enforced" => "Synchronizing",
            "Synchronizing" => "Optimal",
            _ => "Optimal"
        };
        item.LastActivityUtc = DateTime.UtcNow;
    }

    private void BoostScore(QuickGridEnhancementItem item)
    {
        item.Score = Math.Min(100.0, Math.Round(item.Score + 0.5, 1));
        item.LastActivityUtc = DateTime.UtcNow;
    }

    private void DeleteGridItem(QuickGridEnhancementItem item)
    {
        _gridItems.Remove(item);
        if (_selectedGridItem?.Id == item.Id)
        {
            _selectedGridItem = null;
        }
    }

    private void SubmitEnrollmentForm()
    {
        if (string.IsNullOrWhiteSpace(_formNodeId) || _formNodeId.Length < 4)
        {
            _formFeedback = "Validation Failed: Node Identifier must be at least 4 characters.";
            _formIsError = true;
            return;
        }

        if (_formMaxSessions < 100)
        {
            _formFeedback = "Validation Failed: Minimum sessions capacity must be at least 100.";
            _formIsError = true;
            return;
        }

        _enrolledNodes.Insert(0, new EnrolledClusterNode(_formNodeId, _formRegion, _formMaxSessions, DateTime.UtcNow));
        _formFeedback = $"Successfully Enrolled: {_formNodeId} in {_formRegion} with capacity of {_formMaxSessions:N0} sessions.";
        _formIsError = false;
        _formNodeId = $"node-{Random.Shared.Next(100, 999)}";
    }

    // Module 2 logic
    private void TriggerPgoOptimization()
    {
        _mauiMetrics.StartupTimeMs = Math.Max(4.5, Math.Round(_mauiMetrics.StartupTimeMs * 0.85, 1));
        _mauiMetrics.MemoryWorkingSetMb = Math.Max(12.0, Math.Round(_mauiMetrics.MemoryWorkingSetMb * 0.90, 1));
        _mauiMetrics.CpuUsagePercent = Math.Max(0.5, Math.Round(_mauiMetrics.CpuUsagePercent * 0.80, 1));
        _pgoStatusText = "PGO Tier-2 Re-Jitted (Optimal)";
    }

    private void RefreshGps()
    {
        _gpsLat += (Random.Shared.NextDouble() - 0.5) * 0.2;
        _gpsLng += (Random.Shared.NextDouble() - 0.5) * 0.2;

        // Calculate distance from SF HQ (37.7749, -122.4194)
        double dLat = (_gpsLat - 37.7749) * 111.0;
        double dLng = (_gpsLng - (-122.4194)) * 88.0;
        _gpsDistanceKm = Math.Sqrt(dLat * dLat + dLng * dLng);
        _isInsideGeofence = _gpsDistanceKm < 50.0;
    }

    private void SimulateSensorMotion()
    {
        _sensorX = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
        _sensorY = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
        _sensorZ = Math.Round((Random.Shared.NextDouble() - 0.5) * 2.0, 2);
    }

    private void CaptureSensorSnapshot()
    {
        var buffer = new byte[1024];
        Random.Shared.NextBytes(buffer);
        var hash = Convert.ToHexString(SHA256.HashData(buffer)).ToLowerInvariant();
        _capturedFiles.Insert(0, new DeviceSnapshotRecord(
            $"sensor_frame_{Random.Shared.Next(1000, 9999)}.png",
            Math.Round(Random.Shared.NextDouble() * 80 + 20, 1),
            hash,
            DateTime.UtcNow
        ));
    }

    private void AddOfflineItem()
    {
        _syncQueue.Insert(0, new OfflineSyncQueueItem
        {
            Id = Random.Shared.Next(100, 999).ToString(),
            Action = "UPSERT",
            EntityName = $"DeviceTelemetry-{Random.Shared.Next(100, 999)}",
            SyncStatus = "Queued (Pending SQLite Sync)"
        });
    }

    private void SyncOfflineQueue()
    {
        foreach (var item in _syncQueue)
        {
            item.SyncStatus = "Committed to Cloud DB (HTTP 201 Created)";
        }
    }

    // Module 3 logic
    private void ExecuteApiProbe(string route)
    {
        _lastProbedRoute = route;
        _lastProbeLatencyMs = Math.Round(Random.Shared.NextDouble() * 3 + 1.2, 2);

        _apiConsoleOutput = route switch
        {
            "/api/health" => JsonSerializer.Serialize(new
            {
                status = "Healthy",
                framework = ".NET 11.0.0-rc.3",
                uptimeSeconds = 3840,
                allocatedWorkingSetMb = _mauiMetrics.MemoryWorkingSetMb,
                activeRenderMode = _selectedRenderMode.ToString()
            }, new JsonSerializerOptions { WriteIndented = true }),

            "/api/customers" => JsonSerializer.Serialize(new[]
            {
                new { id = 1, name = "Acme Global Dynamics", region = "North America", tier = "Enterprise", activePqcKey = true },
                new { id = 2, name = "Helios Cloud Systems", region = "Europe", tier = "Cloud Native", activePqcKey = true }
            }, new JsonSerializerOptions { WriteIndented = true }),

            "/api/ai/vector-search" => JsonSerializer.Serialize(new
            {
                query = _vectorQuery,
                topSimilarity = 0.962,
                matchedCorpusCount = _vectorResults.Count,
                vectorDimensions = 128
            }, new JsonSerializerOptions { WriteIndented = true }),

            "/api/stream/telemetry" => JsonSerializer.Serialize(new
            {
                status = "Streaming Active",
                protocol = "IAsyncEnumerable<SignalRTelemetryMetric>",
                batchThroughput = "28,450 msgs/sec",
                channel = "Telemetrics.Cluster.UsEast1"
            }, new JsonSerializerOptions { WriteIndented = true }),

            _ => "{\"status\":\"OK\"}"
        };
    }

    private void GenerateStreamTick()
    {
        int rps = Random.Shared.Next(28000, 32500);
        double lat = Math.Round(Random.Shared.NextDouble() * 0.3 + 0.75, 2);
        _streamLogs.Insert(0, new StreamTickLog(
            $"[{DateTime.UtcNow:HH:mm:ss}] Ingested {rps:N0} msgs from cluster us-east-1 (P99: {lat}ms)",
            DateTime.UtcNow
        ));
    }

    private void ClearStreamLogs() => _streamLogs.Clear();

    // Module 4 logic
    private void SetVectorPrompt(string query)
    {
        _vectorQuery = query;
        ExecuteVectorSearch();
    }

    private void ExecuteVectorSearch()
    {
        _vectorResults = DataService.PerformVectorSearch(_vectorQuery);
    }

    private void FilterJsonCategory(string cat)
    {
        _selectedJsonCategory = cat;
        if (cat == "All")
        {
            _generatedSqlPreview = "SELECT c.Id, c.Name, c.MetadataJson FROM Customers AS c";
        }
        else
        {
            _generatedSqlPreview = $"SELECT c.Id, c.Name, c.MetadataJson FROM Customers AS c WHERE json_extract(c.MetadataJson, '$.Category') = '{cat}'";
        }
    }

    // Module 5 logic
    private void ExecuteHardwareBenchmark()
    {
        var sw = Stopwatch.StartNew();
        int iterations = 50_000;
        int gen0Start = GC.CollectionCount(0);

        for (int i = 0; i < iterations; i++)
        {
            var json = JsonSerializer.Serialize(new { Id = i, Code = "BENCH_NET11", Timestamp = DateTime.UtcNow });
            _ = json.Length;
        }

        sw.Stop();
        int gen0End = GC.CollectionCount(0);
        double opsPerSec = (iterations / sw.Elapsed.TotalSeconds);

        _microBenchResult = new MicroBenchmarkResult(sw.Elapsed.TotalMilliseconds, opsPerSec, gen0End - gen0Start);
    }

    // Module 6 logic
    private void SendSuggestedPrompt(string prompt)
    {
        _chatInput = prompt;
        SendChatMessage();
    }

    private void HandleChatKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendChatMessage();
        }
    }

    private void SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(_chatInput)) return;

        _chatMessages.Add(new AiChatMessage { Role = "User", Content = _chatInput });
        var query = _chatInput;
        _chatInput = string.Empty;
        _sessionTokens += query.Split(' ').Length + 48;

        string reply = query.ToLowerInvariant() switch
        {
            var q when q.Contains("aot") => ".NET 11 Native AOT eliminates JIT warmup latency entirely, compiling straight to native machine instructions. Achieves sub-10ms startup time, removes runtime bytecode overhead, and keeps working memory under 15 MB.",
            var q when q.Contains("blazor") => ".NET 11 Blazor Auto Render Mode seamlessly streams initial server-rendered HTML for instant First Contentful Paint, then downloads and caches WebAssembly client assemblies for zero-latency subsequent interactions.",
            var q when q.Contains("maui") => "MAUI Blazor Hybrid in .NET 11 runs with CoreCLR Tiered PGO on Windows and native OS bridges on Android/iOS, providing direct access to GPS, camera, gyroscope, and local offline SQLite storage.",
            var q when q.Contains("ef") || q.Contains("database") || q.Contains("vector") => "EF Core 11 provides native SQL querying over nested JSON columns with LINQ MaxBy/MinBy, paired with high-performance in-memory cosine vector similarity matching.",
            _ => $".NET 11 delivers over 400 kRPS throughput, Native AOT compilation, and deep AI RAG integrations. Query '{query}' matched against local knowledge vectors."
        };

        _chatMessages.Add(new AiChatMessage { Role = "Assistant", Content = reply });
    }

    private void ClearChat()
    {
        _chatMessages.Clear();
        _sessionTokens = 0;
    }

    // Helper records
    private record RenderModeDiagnostics(double BundleSizeKb, double TimeToInteractiveMs, double ServerMemoryPerClientMb, string PipelineDescription);
    private record EnrolledClusterNode(string NodeId, string Region, int MaxSessions, DateTime EnrolledUtc);
    private record DeviceSnapshotRecord(string FileName, double SizeKb, string Sha256Digest, DateTime TimestampUtc);
    private record StreamTickLog(string Message, DateTime Timestamp);
    private record MicroBenchmarkResult(double ElapsedMs, double OpsPerSec, int Gen0Count);
}
