                    <div>
                        <h4 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>📡</span> SignalR Real-Time Telemetry Stream Controller
                        </h4>
                        <p class="text-xs text-slate-400">Live streaming ticks simulation with dynamic throughput calculations.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="GenerateStreamTick"
                                class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs font-bold transition">
                            + Tick Stream
                        </button>
                        <button type="button" @onclick="ClearStreamLogs"
                                class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs transition">
                            Clear
                        </button>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-emerald-400 space-y-1 max-h-48 overflow-y-auto">
                    @foreach (var tick in _streamLogs)
                    {
                        <div class="flex justify-between">
                            <span>@tick.Message</span>
                            <span class="text-slate-500 text-[10px]">@tick.Timestamp.ToString("HH:mm:ss.fff")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
