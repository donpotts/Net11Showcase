                        </p>
                    </div>
                    <button type="button" @onclick="ExecuteHardwareBenchmark"
                            class="px-4 py-2 rounded-xl bg-pink-600 hover:bg-pink-500 text-white font-mono text-xs font-bold transition">
                        ▶ Run Benchmark Now
                    </button>
                </div>

                @if (_microBenchResult != null)
                {
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-400 block text-[10px]">ELAPSED TIME</span>
                            <span class="text-emerald-400 font-bold text-base">@_microBenchResult.ElapsedMs.ToString("F2") ms</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-400 block text-[10px]">THROUGHPUT</span>
                            <span class="text-indigo-400 font-bold text-base">@_microBenchResult.OpsPerSec.ToString("N0") ops/s</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-400 block text-[10px]">GC COLLECTIONS</span>
                            <span class="text-purple-400 font-bold text-base">Gen0: @_microBenchResult.Gen0Count</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800">
                            <span class="text-slate-400 block text-[10px]">ITERATIONS</span>
                            <span class="text-amber-400 font-bold text-base">50,000 JSON</span>
                        </div>
                    </div>
                }
            </div>
        </div>
