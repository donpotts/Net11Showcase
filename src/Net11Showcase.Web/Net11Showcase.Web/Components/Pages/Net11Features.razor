@page "/net11-features"
@rendermode InteractiveServer
@using Net11Showcase.Shared.Services
@inject Net11InnovationsService Innovations
@inject IJSRuntime JS

<PageTitle>.NET 11 IS HERE — Architecture Innovations &amp; C# 15 Showcase</PageTitle>

<div class="space-y-6 max-w-7xl mx-auto pb-12">
    <!-- Header Hero Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 text-slate-900 shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-3 max-w-3xl">
                <div class="flex flex-wrap items-center gap-2">
                    <TwBadge Variant="SemanticVariant.Primary" Size="ComponentSize.Sm" ShowDot="true">
                        🚀 .NET 11 IS HERE
                    </TwBadge>
                    <TwBadge Variant="SemanticVariant.Primary" Size="ComponentSize.Sm">
                        🧬 C# 15 UNIONS
                    </TwBadge>
                    <TwBadge Variant="SemanticVariant.Success" Size="ComponentSize.Sm">
                        ⚡ AVX-512 SIMD
                    </TwBadge>
                    <TwBadge Variant="SemanticVariant.Warning" Size="ComponentSize.Sm">
                        🔥 8.2ms NATIVE AOT
                    </TwBadge>
                </div>
                <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
                    .NET 11 IS HERE
                </h1>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
                    The complete official feature spectrum across <strong>8 Flagship Pillars</strong>: C# 15 Discriminated Unions, ASP.NET Core ShortCircuit, EF Core FullJoin, CoreCLR Runtime-Native Async, Zstandard Libraries, NativeAOT SDK, Windows Forms Modern Styles, and .NET MAUI CoreCLR.
                </p>
            </div>

            <!-- Infographic Toggle & Host Runtime Card -->
            <div class="flex flex-col sm:flex-row lg:flex-col items-center lg:items-end gap-3 shrink-0">
                <TwButton Variant="ButtonVariant.Primary" OnClick="() => _showInfographicModal = true" Class="shadow-md shadow-purple-600/30">
                    <span>🖼️</span>
                    <span>View .NET 11 Infographic</span>
                </TwButton>
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-mono text-center lg:text-right min-w-[210px]">
                    <div class="text-[10px] text-slate-500 uppercase font-bold">Runtime Engine</div>
                    <div class="text-purple-700 font-bold">.NET 11.0.100 STS (GA)</div>
                    <div class="text-[10px] text-slate-600 pt-1 border-t border-slate-200 flex justify-between gap-2">
                        <span>PGO: <strong class="text-emerald-700">Active</strong></span>
                        <span>Arch: <strong class="text-slate-800">win-x64</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BlazorTwUI Infographic Modal -->
    <TwModal @bind-IsOpen="_showInfographicModal" Title=".NET 11 IS HERE — Architectural Reference" Description="8 Flagship Pillars • 40 Promoted Features in .NET 11 STS" MaxWidth="2xl">
        <div class="flex flex-col items-center p-2 space-y-2">
            <img src="images/net11-infographic.jpg" alt=".NET 11 Infographic" class="max-w-full rounded-2xl shadow-xl border border-slate-200" />
        </div>
    </TwModal>

    <!-- 8 Flagship Architectural Pillars Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <button type="button" @onclick='() => SelectPillar("csharp15", "union")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "csharp15" ? "bg-purple-600 text-white shadow-md shadow-purple-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>🧬 1. C# 15</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("aspnet", "span")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "aspnet" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>🌐 2. ASP.NET Core</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("efcore", "span")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "efcore" ? "bg-emerald-600 text-white shadow-md shadow-emerald-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>🗄️ 3. EF Core</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("runtime", "simd")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "runtime" ? "bg-pink-600 text-white shadow-md shadow-pink-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>⚙️ 4. Runtime</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("libraries", "cache")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "libraries" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>📦 5. Libraries</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("sdk", "span")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "sdk" ? "bg-cyan-600 text-white shadow-md shadow-cyan-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>🛠️ 6. SDK</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("winforms", "union")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "winforms" ? "bg-amber-600 text-white shadow-md shadow-amber-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>🖥️ 7. Windows Forms</span>
        </button>
        <button type="button" @onclick='() => SelectPillar("maui", "simd")'
                class="px-4 py-2.5 rounded-2xl font-bold text-xs transition whitespace-nowrap flex items-center gap-1.5 @(_selectedPillar == "maui" ? "bg-teal-600 text-white shadow-md shadow-teal-600/30" : "bg-white text-slate-700 hover:bg-slate-100 border border-slate-200")">
            <span>📱 8. .NET MAUI</span>
        </button>
    </div>

    <!-- Active Pillar Deep-Dive Detail Card (2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left: Pillar Overview, 5 Promoted Feature Pills & Code Diffs (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
            @if (_selectedPillar == "csharp15")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">🧬</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">C# 15 Language Innovations</h3>
                                <span class="text-xs text-slate-500 font-mono">Modern Type System &amp; High-Velocity Syntax</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-purple-50 text-purple-700 border border-purple-200">
                            C# 15 GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Union types
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Closed hierarchies
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Extension indexers
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Collection expression arguments
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Labeled break and continue
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        C# 15 brings landmark language evolution with first-class <strong>Discriminated Unions</strong> via closed value hierarchies, zero-overhead <strong>Extension Indexers</strong>, seamless <strong>Collection Expression Arguments</strong>, and <strong>Labeled break/continue</strong> for deterministic nested loop exits.
                    </p>

                    <!-- Code Demonstration Box -->
                    <TwCodeBlock Code="@CSharp15Code" Language="csharp" FileName="FlightTelemetry.cs — C# 15 Syntax" />
                </div>
            }
            else if (_selectedPillar == "aspnet")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">🌐</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">ASP.NET Core .NET 11</h3>
                                <span class="text-xs text-slate-500 font-mono">High-Throughput Web Pipelines &amp; Cloud Native APIs</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                            ASP.NET Core GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Async Minimal API validation
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            OpenAPI 3.2 by default
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Native OpenTelemetry tracing
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            SignalR invocation cancellation
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            [ShortCircuit] attribute
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        ASP.NET Core in .NET 11 optimizes sub-microsecond HTTP throughput with the <code>[ShortCircuit]</code> attribute, native OpenTelemetry span propagation, async validation filters in Minimal APIs, SignalR cancellation tokens, and automated OpenAPI 3.2 document synthesis.
                    </p>

                    <TwCodeBlock Code="@AspNetCode" Language="csharp" FileName="Program.cs — ASP.NET Core Endpoints" />
                </div>
            }
            else if (_selectedPillar == "efcore")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">🗄️</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">EF Core 11 ORM &amp; Vector Database</h3>
                                <span class="text-xs text-slate-500 font-mono">Modern Relational, Vector &amp; JSON Capabilities</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            EF Core 11 GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            FullJoin support
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            MinByAsync / MaxByAsync
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Complex-type keys and indexes
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Better SQL for joins
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            JSON path existence checks
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        EF Core 11 brings native LINQ <code>FullJoin()</code> translating to standard SQL <code>FULL OUTER JOIN</code>, direct async aggregations via <code>MinByAsync</code> and <code>MaxByAsync</code>, complex-type keys/indexes on nested objects, optimized SQL generation with predicate pushdown, and <code>EF.Functions.JsonExists()</code> for nested JSON schemas.
                    </p>

                    <TwCodeBlock Code="@EfCoreCode" Language="csharp" FileName="ShowcaseDbContext.cs — EF Core 11 LINQ" />
                </div>
            }
            else if (_selectedPillar == "runtime")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">⚙️</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">CoreCLR Runtime &amp; Hardware Acceleration</h3>
                                <span class="text-xs text-slate-500 font-mono">Dynamic PGO, Native Async &amp; AVX-512</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-pink-50 text-pink-700 border border-pink-200">
                            CoreCLR GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Runtime-native async
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            JIT compiler improvements
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Faster NativeAOT interface calls
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            In-process crash reports
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Hardware FP16 support
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        CoreCLR eliminates state machine overhead with <strong>runtime-native async</strong>, advances Tiered PGO loop vectorization, enables sub-nanosecond monomorphic interface dispatch in Native AOT, captures structured in-process crash reports before aborting, and leverages hardware half-precision <strong>FP16 SIMD</strong> instructions.
                    </p>

                    <TwCodeBlock Code="@RuntimeCode" Language="csharp" FileName="CoreClrRuntime.cs — .NET 11 Runtime" />
                </div>
            }
            else if (_selectedPillar == "libraries")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">📦</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Base Class Libraries (BCL) &amp; Compression</h3>
                                <span class="text-xs text-slate-500 font-mono">System.Text.Json, Zstandard &amp; Process APIs</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-blue-50 text-blue-700 border border-blue-200">
                            BCL GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            JSON union support
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            JSON Lines output
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Zstandard compression
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Process run-and-capture APIs
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            MemoryCache OTel metrics
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        Modern libraries in .NET 11 introduce native JSON serialization for C# 15 union types, streaming <strong>JSON Lines</strong> (<code>application/x-ndjson</code>) output, high-throughput <strong>Zstandard compression</strong>, single-line <strong>Process.RunAsync()</strong> execution, and built-in OpenTelemetry metrics on <code>MemoryCache</code>.
                    </p>

                    <TwCodeBlock Code="@LibrariesCode" Language="csharp" FileName="JsonZstdPipelines.cs — .NET 11 Libraries" />
                </div>
            }
            else if (_selectedPillar == "sdk")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">🛠️</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">.NET 11 SDK &amp; Tooling Velocity</h3>
                                <span class="text-xs text-slate-500 font-mono">Build Pipelines, Podman &amp; MSBuild Server</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-cyan-50 text-cyan-700 border border-cyan-200">
                            SDK GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Smaller Linux/macOS installers
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            NativeAOT CLI entry point
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            New dotnet test run controls
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Multi-arch builds with Podman
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            MSBuild server by default
                        </span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed font-normal">
                        Developer velocity accelerates with 40% smaller cross-platform SDK installers, instant NativeAOT CLI tools, multi-process <code>dotnet test</code> execution controls with live terminal reporting, native rootless multi-arch container compilation with Podman, and the background <strong>MSBuild Server</strong> enabled by default.
                    </p>

                    <TwCodeBlock Code="@SdkCode" Language="bash" FileName="dotnet-cli.sh — .NET 11 SDK" />
                </div>
            }
            else if (_selectedPillar == "winforms")
            {
                <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="text-3xl">🖥️</span>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Windows Forms Modern Desktop</h3>
                                <span class="text-xs text-slate-500 font-mono">Fluent Design, Toggle Switches &amp; Kiosk Mode</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-amber-50 text-amber-700 border border-amber-200">
                            WinForms GA
                        </span>
                    </div>

                    <!-- 5 Promoted Infographic Pills -->
                    <div class="flex flex-wrap gap-2">
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Modern visual styles
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            Toggle switches
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
                            SuspendPainting API
                        </span>
                        <span class="px-4 py-1.5 rounded-full font-mono text-xs font-bold shadow-xs inline-block" style="background: linear-gradient(135deg, #7e22ce 0%, #4338ca 100%); color: #ffffff;">
