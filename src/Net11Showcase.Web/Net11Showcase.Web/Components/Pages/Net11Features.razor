                        @if (_pqcMetrics != null)
                        {
                            <div class="space-y-2.5 font-mono text-xs pt-2">
                                <div class="p-3 rounded-2xl bg-purple-50 border border-purple-200 space-y-1">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[10px] text-purple-700 font-bold">PUBLIC KEY FINGERPRINT</span>
                                        <span class="text-emerald-700 font-bold">@_pqcMetrics.GeneratedPublicKeyFingerprint</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 truncate">1,184-byte lattice matrix vector (q = 3329, k = 3)</div>
                                </div>

                                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
                                    <span class="text-[10px] text-slate-500 font-bold block">ENCAPSULATED 256-BIT SHARED SECRET (HEX)</span>
                                    <div class="text-indigo-700 font-bold break-all text-[11px]">@_pqcMetrics.EncapsulatedSecretHex</div>
                                </div>

                                <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-900 text-[11px] font-sans">
                                    🛡️ <strong>Quantum Hardness:</strong> Derived in <strong>@_pqcMetrics.EncapsulationLatencyMs ms</strong>. Provably resilient against Shor &amp; Grover quantum algorithmic factorization.
                                </div>
                            </div>
                        }
                    </div>
                }
                @* Lab Content: 5. HybridCache *@
                else if (_activeLab == "cache")
                {
                    <div class="space-y-4">
                        <div class="text-xs text-slate-600">
                            Simulate multi-tiered cache queries through <strong>HybridCache</strong> to inspect sub-millisecond RAM latency vs distributed tier vs cold database hit.
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" @onclick='() => SelectCacheTier("l1")'
                                     class="py-2 rounded-xl text-xs font-bold transition @(_selectedCacheTier == "l1" ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                                L1 Memory Hit
                            </button>
                            <button type="button" @onclick='() => SelectCacheTier("l2")'
                                     class="py-2 rounded-xl text-xs font-bold transition @(_selectedCacheTier == "l2" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                                L2 Redis Hit
                            </button>
                            <button type="button" @onclick='() => SelectCacheTier("l3")'
                                     class="py-2 rounded-xl text-xs font-bold transition @(_selectedCacheTier == "l3" ? "bg-amber-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                                L3 Cold DB
                            </button>
                        </div>

                        @if (_cacheResult != null)
                        {
                            <div class="space-y-2.5 font-mono text-xs pt-2">
                                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                                    <div>
                                        <span class="text-[10px] text-slate-500 font-bold block">STORAGE TIER</span>
                                        <span class="font-bold text-slate-900">@_cacheResult.StorageTier</span>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-[10px] text-slate-500 font-bold block">ACCESS LATENCY</span>
                                        <span class="font-bold text-sm @(_cacheResult.LatencyMs < 1.0 ? "text-emerald-700" : _cacheResult.LatencyMs < 5.0 ? "text-blue-700" : "text-amber-700")">
                                            @_cacheResult.LatencyMs ms
                                        </span>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
                                    <span class="text-[10px] text-slate-500 font-bold block">STAMPEDE PROTECTION</span>
                                    <span class="text-slate-800 text-xs">@_cacheResult.StampedeProtectionStatus</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _selectedPillar = "csharp15";
    private string _activeLab = "union";
    private bool _showInfographicModal = false;

    // C# 15 Union Lab State
    private string _selectedUnionVariant = "nominal";
    private Net11InnovationsService.UnionEvaluationResult? _unionResult;
    private bool _isRunningUnionBench = false;
    private Net11InnovationsService.UnionBenchmarkComparison? _unionBenchResult;

    // Zero-Alloc Span Lab State
    private bool _isRunningSpanBench = false;
    private Net11InnovationsService.ParamsAllocationComparison? _spanResult;

    // SIMD Lab State
    private bool _isRunningSimdBench = false;
    private Net11InnovationsService.SimdVectorComparison? _simdResult;

    // PQC Lab State
    private Net11InnovationsService.PqcLatticeMetrics? _pqcMetrics;

    // HybridCache Lab State
    private string _selectedCacheTier = "l1";
    private Net11InnovationsService.CacheTierResult? _cacheResult;

    protected override void OnInitialized()
    {
        // Populate initial state
        _unionResult = Innovations.EvaluateUnionVariant("nominal");
        _spanResult = Innovations.RunParamsSpanBenchmark(100_000);
        _simdResult = Innovations.RunSimdVectorBenchmark(100_000);
        _pqcMetrics = Innovations.GeneratePqcLatticeEnclave();
        _cacheResult = Innovations.SimulateCacheAccess("l1");
    }

    private void SelectPillar(string pillar, string defaultLab)
    {
        _selectedPillar = pillar;
        _activeLab = defaultLab;
    }

    private void SelectUnionVariant(string variant)
    {
        _selectedUnionVariant = variant;
        _unionResult = Innovations.EvaluateUnionVariant(variant);
    }

    private async Task ExecuteUnionBenchmark()
    {
        if (_isRunningUnionBench) return;
        _isRunningUnionBench = true;
        await Task.Delay(150);
        _unionBenchResult = Innovations.RunUnionBenchmark(100_000);
        _isRunningUnionBench = false;
    }

    private async Task ExecuteSpanBenchmark()
    {
        if (_isRunningSpanBench) return;
        _isRunningSpanBench = true;
        await Task.Delay(150);
        _spanResult = Innovations.RunParamsSpanBenchmark(100_000);
        _isRunningSpanBench = false;
    }

    private async Task ExecuteSimdBenchmark()
    {
        if (_isRunningSimdBench) return;
        _isRunningSimdBench = true;
        await Task.Delay(150);
        _simdResult = Innovations.RunSimdVectorBenchmark(100_000);
        _isRunningSimdBench = false;
    }

    private void ExecutePqcGeneration()
    {
        _pqcMetrics = Innovations.GeneratePqcLatticeEnclave();
    }

    private void SelectCacheTier(string tier)
    {
        _selectedCacheTier = tier;
        _cacheResult = Innovations.SimulateCacheAccess(tier);
    }
}
