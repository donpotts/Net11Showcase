@page "/contract-signer"
@rendermode InteractiveServer
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Enterprise Contract Signer &amp; PDF Sealing Studio - .NET 11 GA</PageTitle>

<div class="space-y-6 max-w-7xl mx-auto pb-12">
    @if (_isSealed)
    {
        <div class="p-4 rounded-2xl bg-emerald-600 text-white font-sans text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-lg">
            <div class="flex items-center gap-3">
                <span class="text-2xl">✅</span>
                <div>
                    <span class="font-bold text-sm block">Document Cryptographically Sealed &amp; Flattened</span>
                    <span class="text-emerald-100 text-[11px] font-mono break-all">Digest: @_sha256Digest</span>
                </div>
            </div>
            <button type="button" @onclick="UnlockDocument" class="px-4 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs border border-emerald-500 shrink-0">
                🔓 Unlock to Edit
            </button>
        </div>
    }

    <!-- Header Banner -->
    <div class="p-6 rounded-3xl bg-white border border-slate-200 text-slate-900 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-600 to-pink-500 flex items-center justify-center text-2xl shadow-lg shrink-0">
                📜
            </div>
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                        ⚡ .NET 11 REAL SAMPLE APP
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        🔐 SHA-256 CRYPTOGRAPHIC SEAL
                    </span>
                    @if (_isSealed)
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-50 text-amber-700 border border-amber-200 animate-pulse">
                            🛡️ FLATTENED &amp; SEALED
                        </span>
                    }
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1">
                    Enterprise SLA Contract Signer &amp; PDF Sealing Studio
                </h1>
                <p class="text-xs sm:text-sm text-slate-600">
                    Demonstrating BlazorTwUI signature capture, cryptographic SHA-256 document hashing, and tamper-evident stream flattening.
                </p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" @onclick="DownloadFlattenedPdf"
                    class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                <span>📥</span>
                <span>Download Flattened PDF</span>
            </button>
            @if (_isSealed)
            {
                <button type="button" @onclick="UnlockDocument"
                        class="px-4 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold transition border border-slate-300 shadow-xs">
                    🔓 Unlock &amp; Edit
                </button>
            }
            else
            {
                <button type="button" @onclick="ResetDocument"
                        class="px-4 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold transition border border-slate-300 shadow-xs">
                    🔄 Reset Form
                </button>
                <button type="button" @onclick="SealDocument" disabled="@(!CanSeal)"
                        class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-bold transition flex items-center gap-2 shadow-lg shadow-indigo-600/30">
                    <span>🔒</span>
                    <span>Sign &amp; Seal Document</span>
                </button>
            }
        </div>
    </div>

    <!-- Main Contract Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left: Contract Document Workstation (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Document Meta Details Card -->
            <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="text-indigo-600 font-bold text-sm">SECTION 1:</span>
                        <h2 class="text-base font-bold text-slate-900">Party Identification &amp; Master Terms</h2>
                    </div>
                    <span class="text-xs font-mono text-slate-500">REF: MSA-2026-NET11</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Signatory Legal Name</label>
                        <input type="text" value="@_signerName" @oninput="OnSignerNameInput" disabled="@_isSealed"
                               placeholder="e.g. Sarah Connor"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-xs font-medium focus:border-indigo-500 focus:outline-none transition disabled:opacity-60" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Corporation / Organization</label>
                        <input type="text" @bind="_companyName" @bind:event="oninput" disabled="@_isSealed"
                               placeholder="e.g. Cyberdyne Systems Corp"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-xs font-medium focus:border-indigo-500 focus:outline-none transition disabled:opacity-60" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Corporate Email Address</label>
                        <input type="email" @bind="_signerEmail" @bind:event="oninput" disabled="@_isSealed"
                               placeholder="sconnor@cyberdyne.io"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-xs font-medium focus:border-indigo-500 focus:outline-none transition disabled:opacity-60" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Infrastructure SLA Tier</label>
                        <select @bind="_slaTier" disabled="@_isSealed"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-xs font-bold focus:border-indigo-500 focus:outline-none transition disabled:opacity-60">
                            <option value="Mission Critical (99.999% SLA)">Mission Critical (99.999% SLA) - 415k RPS</option>
                            <option value="Enterprise High-Availability (99.99% SLA)">Enterprise High-Availability (99.99% SLA)</option>
                            <option value="Standard Production (99.9% SLA)">Standard Production (99.9% SLA)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Authorized Annual Cloud Budget Cap</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-2.5 text-xs text-slate-500 font-bold">$</span>
                        <input type="number" @bind="_budgetCap" @bind:event="oninput" disabled="@_isSealed"
                               class="w-full pl-8 pr-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-xs font-mono font-bold focus:border-indigo-500 focus:outline-none transition disabled:opacity-60" />
                    </div>
                </div>
            </div>

            <!-- Agreement Terms & Acceptance Checklist -->
            <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center gap-2 pb-3 border-b border-slate-200">
                    <span class="text-indigo-600 font-bold text-sm">SECTION 2:</span>
                    <h2 class="text-base font-bold text-slate-900">Legal Obligations &amp; Technical Compliance</h2>
                </div>

                <div class="space-y-3 text-xs">
                    <label class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                        <input type="checkbox" @bind="_acceptAotTerms" @bind:after="CalculateDigest" disabled="@_isSealed"
                               class="w-4 h-4 mt-0.5 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 bg-white" />
                        <span class="text-slate-700 leading-relaxed font-normal">
                            <strong>1. Zero Cold-Boot Warmup:</strong> Subscriber acknowledges that services operate under .NET 11 Native AOT compilation with deterministic sub-10ms startup boundaries.
                        </span>
                    </label>

                    <label class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                        <input type="checkbox" @bind="_acceptCryptoTerms" @bind:after="CalculateDigest" disabled="@_isSealed"
                               class="w-4 h-4 mt-0.5 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 bg-white" />
                        <span class="text-slate-700 leading-relaxed font-normal">
                            <strong>2. Post-Quantum Lattice Protocol:</strong> All API tokens and transmission payloads shall adhere to NIST FIPS 203 ML-KEM-768 lattice cryptography.
                        </span>
                    </label>

                    <label class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                        <input type="checkbox" @bind="_acceptTamperProof" @bind:after="CalculateDigest" disabled="@_isSealed"
                               class="w-4 h-4 mt-0.5 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 bg-white" />
                        <span class="text-slate-700 leading-relaxed font-normal">
                            <strong>3. Tamper-Evident SHA-256 Flattening:</strong> Once sealed, this contract's byte hash is registered immutably in the local audit register.
                        </span>
                    </label>
                </div>
            </div>

            <!-- Interactive Digital Signature Canvas -->
            <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="text-indigo-600 font-bold text-sm">SECTION 3:</span>
                        <h2 class="text-base font-bold text-slate-900">Authorized Digital Signature</h2>
                    </div>
                    @if (!string.IsNullOrEmpty(_signatureData) || _hasManualDrawn)
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            ✓ Signature Stroke Captured
                        </span>
                    }
                </div>

                <div class="space-y-3">
                    <p class="text-xs text-slate-600">
                        Draw below using your mouse/touch, or choose an official preset signature stamp:
                    </p>

                    <!-- Quick Preset Signatures -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button" @onclick='() => ApplyPresetSignature("Executive")' disabled="@_isSealed"
                                class="px-3.5 py-2 rounded-xl @(_selectedPreset == "Executive" ? "bg-indigo-600 text-white font-bold" : "bg-slate-100 hover:bg-slate-200 text-slate-800") text-xs font-bold transition border border-slate-300">
                            ✍️ Formal Executive
                        </button>
                        <button type="button" @onclick='() => ApplyPresetSignature("Counsel")' disabled="@_isSealed"
                                class="px-3.5 py-2 rounded-xl @(_selectedPreset == "Counsel" ? "bg-indigo-600 text-white font-bold" : "bg-slate-100 hover:bg-slate-200 text-slate-800") text-xs font-bold transition border border-slate-300">
                            🖋️ General Counsel
                        </button>
                        <button type="button" @onclick='() => ApplyPresetSignature("Architect")' disabled="@_isSealed"
                                class="px-3.5 py-2 rounded-xl @(_selectedPreset == "Architect" ? "bg-indigo-600 text-white font-bold" : "bg-slate-100 hover:bg-slate-200 text-slate-800") text-xs font-bold transition border border-slate-300">
                            ⚡ Chief Architect
                        </button>
                        <button type="button" @onclick="ClearSignature" disabled="@_isSealed"
                                class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-xs font-bold text-rose-700 transition border border-rose-200">
                            ✕ Clear Signature
                        </button>
                    </div>

                    <!-- Interactive Signature Visual / Drawing Box -->
                    <div class="relative h-48 rounded-2xl bg-white border-2 border-dashed @(_isSealed ? "border-emerald-500 bg-emerald-50/20" : "border-indigo-400 hover:border-indigo-600") flex flex-col justify-between overflow-hidden select-none shadow-xs">
                        <div class="flex items-center justify-between px-4 pt-2.5 text-[11px] text-slate-500 font-mono z-10 pointer-events-none">
                            <span>SIGNATURE CAPTURE PLANE</span>
                            <span class="font-bold @(_isSealed ? "text-emerald-700" : "text-indigo-700")">
                                @(_isSealed ? "🔒 DOCUMENT SEALED & LOCKED" : _hasManualDrawn ? "IN-FLIGHT INK STROKE ACTIVE" : "READY FOR SIGNATURE")
                            </span>
                        </div>

                        <!-- Canvas Drawing Surface (Zero Mouse Offset) -->
                        <div class="flex-1 relative w-full h-full">
                            <canvas id="signatureCanvas"
                                    class="absolute inset-0 w-full h-full @(_isSealed ? "cursor-not-allowed opacity-95" : "cursor-crosshair")"
                                    style="touch-action: none;"
                                    data-sealed="@(_isSealed.ToString().ToLowerInvariant())"></canvas>

                            @if (string.IsNullOrEmpty(_signatureData) && !_hasManualDrawn && !_isSealed)
                            {
                                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-slate-400 text-xs gap-1 font-medium">
                                    <span class="text-3xl">✍️</span>
                                    <span>Draw directly with mouse/stylus (zero offset), or select a preset stamp above</span>
                                </div>
                            }
                        </div>

                        <div class="border-t border-slate-200 px-4 py-2 flex items-center justify-between text-[10px] text-slate-500 font-mono z-10 pointer-events-none bg-slate-50/80">
                            <span>SIGNATORY: <strong class="text-slate-800">@(_signerName.Length > 0 ? _signerName : "UNSPECIFIED")</strong></span>
                            <span>SEAL HASH: <strong class="text-indigo-700 font-mono">#@(_signatureHash)</strong></span>
                        </div>
                    </div>
                </div>

                <!-- Bottom Direct Seal Bar -->
                <div class="mt-4 p-5 rounded-2xl bg-indigo-50 border border-indigo-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h4 class="text-sm font-bold text-indigo-950">
                            @(_isSealed ? "✓ Contract Successfully Sealed" : "Ready to Seal Document?")
                        </h4>
                        <p class="text-xs text-indigo-700 mt-0.5">
                            @if (_isSealed)
                            {
                                <span>All boundaries frozen. Document is locked under SHA-256 seal.</span>
                            }
                            else if (!CanSeal)
                            {
                                <span>Please verify your signatory name, accept all 3 legal terms, and provide a signature above.</span>
                            }
                            else
                            {
                                <span>All prerequisites verified. Click below to flatten and seal this contract.</span>
                            }
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" @onclick="DownloadFlattenedPdf"
                                class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold border border-slate-700 shadow-sm transition flex items-center gap-1.5">
                            <span>📥</span>
                            <span>Download Flattened PDF</span>
                        </button>
                        @if (_isSealed)
                        {
                            <button type="button" @onclick="UnlockDocument"
                                    class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 text-xs font-bold border border-slate-300 shadow-sm transition">
                                🔓 Unlock &amp; Edit
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="SealDocument" disabled="@(!CanSeal)"
                                    class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition flex items-center gap-2">
                                <span>🔒</span>
                                <span>Sign &amp; Seal Document</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Cryptographic Seal & Verification Pane (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Cryptographic Verification Card -->
            <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🔐</span>
                        <h3 class="text-base font-bold text-slate-900">SHA-256 Integrity Certificate</h3>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-50 text-purple-700 border border-purple-200">
                        NIST CERTIFIED
                    </span>
                </div>

                <div class="space-y-4">
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 font-mono text-xs space-y-2">
                        <div class="text-slate-600 text-[11px] font-bold">IMMUTABLE PAYLOAD DIGEST:</div>
                        <div class="text-emerald-800 text-[11px] font-mono font-bold break-all leading-relaxed p-2.5 rounded-xl bg-emerald-50 border border-emerald-200">
                            @_sha256Digest
                        </div>
                        <div class="flex items-center justify-between text-[10px] text-slate-500 pt-1">
                            <span>ALGORITHM: SHA-256</span>
                            <span>ENCODING: UTF-8 / HEX</span>
                        </div>
                    </div>

                    <!-- Seal Status Timeline -->
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-3 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full @(_signerName.Length > 0 ? "bg-emerald-600" : "bg-slate-300")"></span>
                            <span class="@(_signerName.Length > 0 ? "text-slate-800 font-medium" : "text-slate-500")">Signatory Identity: @(_signerName.Length > 0 ? _signerName : "Required")</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full @(AllTermsAccepted ? "bg-emerald-600" : "bg-slate-300")"></span>
                            <span class="@(AllTermsAccepted ? "text-slate-800 font-medium" : "text-slate-500")">3/3 Mandatory Legal Clauses Accepted</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full @((!string.IsNullOrEmpty(_signatureData) || _hasManualDrawn) ? "bg-emerald-600" : "bg-slate-300")"></span>
                            <span class="@((!string.IsNullOrEmpty(_signatureData) || _hasManualDrawn) ? "text-slate-800 font-medium" : "text-slate-500")">Digital Signature Stroke Captured</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="w-2.5 h-2.5 rounded-full @(_isSealed ? "bg-emerald-600 shadow-sm shadow-emerald-400/50" : "bg-slate-300")"></span>
                            <span class="@(_isSealed ? "text-emerald-700 font-bold" : "text-slate-500")">Cryptographic Seal Finalized &amp; Flattened</span>
                        </div>
                    </div>

                    @if (_isSealed)
                    {
                        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs space-y-2">
                            <div class="flex items-center gap-2 font-bold text-sm">
                                <span>✓</span>
                                <span>Document Flattened &amp; Sealed</span>
                            </div>
                            <p class="text-[11px] text-emerald-800 leading-relaxed">
                                Form fields have been merged into an unalterable static stream. All edit boundaries locked.
                            </p>
                            <div class="pt-2 flex flex-wrap gap-2">
                                <button type="button" @onclick="CopyPayloadJson"
                                        class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition">
                                    📋 Copy Sealed Audit JSON
                                </button>
                                <button type="button" @onclick="DownloadFlattenedPdf"
                                        class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition border border-slate-700 shadow-sm flex items-center gap-1.5">
                                    <span>📥</span> Download Flattened PDF
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_actionNotice))
                            {
                                <div class="p-2.5 rounded-xl bg-emerald-100 text-emerald-900 font-mono text-[11px] flex items-center justify-between border border-emerald-300">
                                    <span>✓ @_actionNotice</span>
                                    <button type="button" @onclick='() => _actionNotice = null' class="font-bold hover:text-black">✕</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Sealed Metadata Inspector -->
            <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-3 font-mono text-xs">
                <div class="text-slate-600 text-xs font-bold font-sans">LIVE CONTRACT AUDIT TELEMETRY</div>
                <div class="space-y-1.5 text-[11px]">
                    <div class="flex justify-between text-slate-500">
                        <span>RUNTIME:</span>
                        <span class="text-indigo-600 font-bold">.NET 11.0.0 (GA)</span>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>COMPONENT:</span>
                        <span class="text-slate-800 font-medium">BlazorTwUI TwPdfFormFiller</span>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>BYTES CONSUMED:</span>
                        <span class="text-slate-800 font-medium">@(_payloadBytes) bytes</span>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>SEAL STATUS:</span>
                        <span class="@(_isSealed ? "text-emerald-700 font-bold" : "text-amber-600 font-bold")">
                            @(_isSealed ? "LOCKED & FLATTENED" : "DRAFT (MUTABLE)")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _signerName = "Sarah Connor";
    private string _companyName = "Cyberdyne Systems Corp";
    private string _signerEmail = "sconnor@cyberdyne.io";
    private string _slaTier = "Mission Critical (99.999% SLA)";
    private decimal _budgetCap = 1250000m;

    private bool _acceptAotTerms = true;
    private bool _acceptCryptoTerms = true;
    private bool _acceptTamperProof = true;

    private string _signatureData = "Sarah Connor";
    private string _signatureHash = "84f1a9";
    private string _selectedPreset = "Executive";
    private bool _hasManualDrawn = false;

    private bool _isSealed = false;
    private string? _actionNotice;

    private string _sha256Digest = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    private int _payloadBytes = 412;

    private bool AllTermsAccepted => _acceptAotTerms && _acceptCryptoTerms && _acceptTamperProof;
    private bool CanSeal => !string.IsNullOrWhiteSpace(_signerName) && AllTermsAccepted && (!string.IsNullOrWhiteSpace(_signatureData) || _hasManualDrawn) && !_isSealed;

    protected override void OnInitialized()
    {
        CalculateDigest();
    }

    private async Task OnSignerNameInput(ChangeEventArgs e)
    {
        _signerName = e.Value?.ToString() ?? "";
        if (!_hasManualDrawn)
        {
            _signatureData = _signerName;
            if (!string.IsNullOrEmpty(_selectedPreset))
            {
                string title = _selectedPreset switch
                {
                    "Executive" => "Executive Officer",
                    "Counsel" => "Esq., Legal Counsel",
                    "Architect" => "Chief Architect",
                    _ => "Signatory"
                };
                try { await JS.InvokeVoidAsync("contractPad.renderPreset", _signerName, title); } catch { }
            }
        }
        CalculateDigest();
    }

    private DotNetObjectReference<ContractSigner>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("contractPad.init", "signatureCanvas", _dotNetRef);
                var name = string.IsNullOrWhiteSpace(_signerName) ? "Sarah Connor" : _signerName;
                await JS.InvokeVoidAsync("contractPad.renderPreset", name, "Executive Officer");
            }
            catch { }
        }
    }

    [JSInvokable]
    public void OnManualStrokeDrawn(string dataUrl)
    {
        _hasManualDrawn = true;
        _signatureData = "Manual Biometric Ink Stroke";
        _selectedPreset = "";
        using var sha = SHA256.Create();
        var hashBytes = sha.ComputeHash(Encoding.UTF8.GetBytes(dataUrl));
        _signatureHash = Convert.ToHexString(hashBytes)[..8];
        CalculateDigest();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStrokeDrawn(string dataUrl) => OnManualStrokeDrawn(dataUrl);

    private async Task ApplyPresetSignature(string preset)
    {
        if (_isSealed) return;
        _hasManualDrawn = false;
        var name = string.IsNullOrWhiteSpace(_signerName) ? "Sarah Connor" : _signerName;

        string title = preset switch
        {
            "Executive" => "Executive Officer",
            "Counsel" => "Esq., Legal Counsel",
            "Architect" => "Chief Architect",
            _ => "Signatory"
        };
        _signatureData = $"{name} ({title})";
        _selectedPreset = preset;

        using var sha = SHA256.Create();
        var hashBytes = sha.ComputeHash(Encoding.UTF8.GetBytes(_signatureData + DateTime.UtcNow.Ticks));
        _signatureHash = Convert.ToHexString(hashBytes)[..8];
        CalculateDigest();
        try { await JS.InvokeVoidAsync("contractPad.renderPreset", name, title); } catch { }
    }

    private async Task ClearSignature()
    {
        if (_isSealed) return;
        _signatureData = string.Empty;
        _hasManualDrawn = false;
        _selectedPreset = "";
        _signatureHash = "00000000";
        CalculateDigest();
        try { await JS.InvokeVoidAsync("contractPad.clear"); } catch { }
    }

    private void CalculateDigest()
    {
        var payload = new
        {
            Document = "MSA-2026-NET11",
            Signer = _signerName,
            Company = _companyName,
            Email = _signerEmail,
            Sla = _slaTier,
            Budget = _budgetCap,
            TermsAccepted = AllTermsAccepted,
            Signature = !string.IsNullOrEmpty(_signatureData) ? $"{_signatureData} [#{_signatureHash}]" : "UNSIGNED",
            IsSealed = _isSealed
        };

        var json = JsonSerializer.Serialize(payload);
        var bytes = Encoding.UTF8.GetBytes(json);
        _payloadBytes = bytes.Length;

        using var sha = SHA256.Create();
        _sha256Digest = Convert.ToHexString(sha.ComputeHash(bytes)).ToLowerInvariant();
    }

    private void SealDocument()
    {
        if (!CanSeal) return;
        _isSealed = true;
        CalculateDigest();
    }

    private void UnlockDocument()
    {
        _isSealed = false;
        _actionNotice = null;
        CalculateDigest();
    }

    private async Task ResetDocument()
    {
        _isSealed = false;
        _signerName = "Sarah Connor";
        _companyName = "Cyberdyne Systems Corp";
        _signerEmail = "sconnor@cyberdyne.io";
        _signatureData = "Sarah Connor";
        _selectedPreset = "Executive";
        _hasManualDrawn = false;
        _acceptAotTerms = true;
        _acceptCryptoTerms = true;
        _acceptTamperProof = true;
        _actionNotice = null;
        CalculateDigest();
        try { await JS.InvokeVoidAsync("contractPad.clear"); } catch { }
    }

    private async Task CopyPayloadJson()
    {
        var audit = new
        {
            CertificateId = Guid.NewGuid().ToString(),
            Algorithm = "SHA-256",
            Digest = _sha256Digest,
            Timestamp = DateTime.UtcNow,
            Signer = _signerName,
            Company = _companyName,
            Sla = _slaTier,
            Budget = _budgetCap,
            Status = "FLATTENED_SEALED"
        };
        var json = JsonSerializer.Serialize(audit, new JsonSerializerOptions { WriteIndented = true });
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
            _actionNotice = "Sealed audit JSON copied to clipboard!";
        }
        catch
        {
            _actionNotice = "Sealed audit JSON ready (clipboard permissions restricted).";
        }
    }

    private async Task DownloadFlattenedPdf()
    {
        var contractPayload = new
        {
            documentId = "MSA-2026-NET11",
            signerName = string.IsNullOrWhiteSpace(_signerName) ? "Sarah Connor" : _signerName,
            companyName = string.IsNullOrWhiteSpace(_companyName) ? "Enterprise Client" : _companyName,
            email = string.IsNullOrWhiteSpace(_signerEmail) ? "signer@enterprise.com" : _signerEmail,
            slaTier = _slaTier,
            budget = _budgetCap,
            digest = _sha256Digest,
            isSealed = _isSealed
        };

        try
        {
            await JS.InvokeVoidAsync("downloadContractPdf", contractPayload);
            _actionNotice = $"✓ Flattened PDF generated ({_payloadBytes} bytes, SHA-256: {_sha256Digest[..12]}...). Download started in your browser.";
        }
        catch (Exception ex)
        {
            _actionNotice = $"Download error: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
