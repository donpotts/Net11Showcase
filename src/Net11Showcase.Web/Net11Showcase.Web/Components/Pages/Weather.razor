@page "/weather"
@attribute [StreamRendering]

<PageTitle>Weather Telemetry — .NET 11 Showcase</PageTitle>

<div class="space-y-6">
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 text-slate-900 shadow-sm space-y-2">
        <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-cyan-50 text-cyan-700 border border-cyan-200">
                ☁️ STREAM RENDERING
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                ⚡ ASYNC PIPELINE
            </span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">Real-Time Atmospheric Telemetry</h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-2xl">
            Demonstrates Blazor 11 async HTML streaming (`[StreamRendering]`). The initial shell renders instantly while backend forecast data streams chunk-by-chunk.
        </p>
    </div>

    <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        @if (Forecasts is null)
        {
            <div class="p-8 text-center text-slate-500 font-mono text-sm flex items-center justify-center gap-2">
                <span class="w-3 h-3 rounded-full bg-cyan-500 animate-ping"></span>
                <span>Streaming forecast telemetry over HTTP stream...</span>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-2xl border border-slate-200">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50/80 text-slate-500 uppercase text-[10px] border-b border-slate-200 font-bold">
                        <tr>
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4" aria-label="Temperature in Celsius">Temp (C)</th>
                            <th class="py-3 px-4" aria-label="Temperature in Fahrenheit">Temp (F)</th>
                            <th class="py-3 px-4">Summary</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var forecast in Forecasts)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3 px-4 font-bold text-slate-900">@forecast.Date.ToShortDateString()</td>
                                <td class="py-3 px-4 text-cyan-700 font-bold">@forecast.TemperatureC °C</td>
                                <td class="py-3 px-4 text-slate-700">@forecast.TemperatureF °F</td>
                                <td class="py-3 px-4">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                        @forecast.Summary
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    public WeatherForecast[]? Forecasts { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Forecasts is null)
        {
            // Simulate asynchronous loading to demonstrate streaming rendering
            await Task.Delay(350);

            var startDate = DateOnly.FromDateTime(DateTime.Now);
            var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
            Forecasts = Enumerable.Range(1, 7).Select(index => new WeatherForecast
            {
                Date = startDate.AddDays(index),
                TemperatureC = Random.Shared.Next(-10, 42),
                Summary = summaries[Random.Shared.Next(summaries.Length)]
            }).ToArray();
        }
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
