@page "/agent-ops"
@rendermode InteractiveServer
@using Net11Showcase.Components.AgentOps

<PageTitle>Agent Ops (Human-in-the-Loop) — .NET 11 Showcase</PageTitle>

<div class="space-y-6">
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200 text-slate-900 shadow-sm space-y-2">
        <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                🛡️ HUMAN-IN-THE-LOOP AGENT OPS
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                ⚡ REFUND DESK SUPERVISOR
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-50 text-purple-700 border border-purple-200">
                🔒 AUDIT TRAILS &amp; GATES
            </span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">Agent Ops: Approvals, Takeover &amp; Audit</h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-3xl leading-relaxed font-medium">
            A refund-desk agent proposes a high-risk action. It does not run until you approve it. Take over to pause the agent and
            edit what it knows; hand back and it carries on with your change. Every step lands in the audit trail.
        </p>
    </div>

    <TwAgentConsole />
</div>
